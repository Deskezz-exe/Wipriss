<Window x:Class="Wipriss.App.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        UseLayoutRounding="True"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="16,14,12,12">
            <ContentControl x:Name="GlyphSocket" Style="{StaticResource Socket}" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Закрыть (Esc)"
                    Click="Close_Click" />
            <TextBlock x:Name="TitleText" Margin="11,0,0,1" Style="{StaticResource PanelTitle}" VerticalAlignment="Center" />
        </DockPanel>
        <ContentControl x:Name="Host" Margin="16,2,16,16" Focusable="False" />
    </DockPanel>
</Window>
