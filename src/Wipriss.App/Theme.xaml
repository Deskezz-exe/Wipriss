<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Palette: warm graphite with one quiet sage accent.
        Greys lean slightly warm so the island reads like dark metal, not a cold web page.
        The accent marks "on" and the main action only. Nothing bright anywhere.
    -->
    <Color x:Key="InkColor">#0B0B0A</Color>
    <Color x:Key="WindowColor">#121110</Color>
    <Color x:Key="HairlineColor">#2A2825</Color>
    <Color x:Key="TextColor">#ECE8E1</Color>

    <SolidColorBrush x:Key="IslandBrush" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="IslandBorderBrush" Color="#26241F" />
    <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource WindowColor}" />
    <SolidColorBrush x:Key="SunkenBrush" Color="#0D0C0B" />
    <SolidColorBrush x:Key="TileBrush" Color="#151412" />
    <SolidColorBrush x:Key="CardBrush" Color="#191816" />
    <SolidColorBrush x:Key="TileHoverBrush" Color="#211F1C" />
    <SolidColorBrush x:Key="PressedBrush" Color="#1B1A17" />
    <SolidColorBrush x:Key="DividerBrush" Color="#24221F" />
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource HairlineColor}" />
    <SolidColorBrush x:Key="LineStrongBrush" Color="#3A3833" />

    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#8E8A81" />
    <SolidColorBrush x:Key="FaintTextBrush" Color="#5C5952" />

    <SolidColorBrush x:Key="AccentBrush" Color="#A6BEAB" />
    <SolidColorBrush x:Key="AccentFillBrush" Color="#222B24" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#29342C" />
    <SolidColorBrush x:Key="AccentLineBrush" Color="#41544A" />

    <SolidColorBrush x:Key="OkBrush" Color="#93B89D" />
    <SolidColorBrush x:Key="WarnBrush" Color="#C9A566" />
    <SolidColorBrush x:Key="DangerBrush" Color="#D2826F" />

    <!-- The island's machined edge: a touch lighter on top, like light falling on metal -->
    <LinearGradientBrush x:Key="IslandEdgeBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#3A3832" />
        <GradientStop Offset="0.45" Color="#23211E" />
        <GradientStop Offset="1" Color="#1B1A17" />
    </LinearGradientBrush>

    <!-- Key cap that holds a module's icon -->
    <LinearGradientBrush x:Key="SocketFillBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#26241F" />
        <GradientStop Offset="1" Color="#1A1916" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SocketEdgeBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#44413B" />
        <GradientStop Offset="1" Color="#26241F" />
    </LinearGradientBrush>

    <!-- Segoe UI Variable comes with Windows 11; Windows 10 falls back to Segoe UI -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="SmallFont">Segoe UI Variable Small, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- The Wipriss mark, same geometry as assets/logo/wipriss.svg -->
    <GeometryGroup x:Key="LogoGeometry" FillRule="Nonzero">
        <RectangleGeometry Rect="112,112,288,288" RadiusX="30" RadiusY="30" />
        <RectangleGeometry Rect="624,112,288,288" RadiusX="30" RadiusY="30" />
        <RectangleGeometry Rect="112,624,288,288" RadiusX="30" RadiusY="30" />
        <RectangleGeometry Rect="624,624,288,288" RadiusX="30" RadiusY="30" />
        <RectangleGeometry Rect="492,306,40,412" />
        <RectangleGeometry Rect="306,492,412,40" />
        <RectangleGeometry Rect="402,402,220,220" RadiusX="34" RadiusY="34" />
    </GeometryGroup>

    <!-- Text roles -->
    <Style x:Key="PanelTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SmallFont}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--
        A module's icon sitting in a small key cap. IsEnabled="False" draws an empty slot instead:
        the module is planned but not built yet.
    -->
    <Style x:Key="Socket" TargetType="ContentControl">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border x:Name="Cap" CornerRadius="8" BorderThickness="1"
                                Background="{StaticResource SocketFillBrush}" BorderBrush="{StaticResource SocketEdgeBrush}" />
                        <Rectangle x:Name="Slot" RadiusX="8" RadiusY="8" Stroke="{StaticResource LineStrongBrush}"
                                   StrokeThickness="1" StrokeDashArray="2.5 2" Visibility="Collapsed" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Cap" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Slot" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource FaintTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Width="30" Height="30" CornerRadius="8" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource TileHoverBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource PressedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PlainButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="8" Padding="13,6" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource TileHoverBrush}" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource PressedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The one main action on a panel -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource PlainButton}">
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="Background" Value="{StaticResource AccentFillBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentLineBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="8" Padding="13,6" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentFillBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TileBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource TileBrush}" />
        <Setter Property="BorderBrush" Value="#1E1C1A" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="Padding" Value="10,9" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#1C1B18" />
                <Setter Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- CheckBox drawn as an on/off switch -->
    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Border x:Name="Track" Grid.Column="1" Width="38" Height="22" CornerRadius="11"
                                Background="{StaticResource SunkenBrush}" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1">
                            <Ellipse x:Name="Thumb" Width="12" Height="12" Fill="#6B6760"
                                     HorizontalAlignment="Left" Margin="4,0,0,0" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Thumb" Property="Fill" Value="#8E8A81" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentFillBrush}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentLineBrush}" />
                            <Setter TargetName="Thumb" Property="Fill" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Thumb" Property="Width" Value="14" />
                            <Setter TargetName="Thumb" Property="Height" Value="14" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text field with a placeholder taken from Tag -->
    <Style x:Key="InputBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource SunkenBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
        <Setter Property="SelectionBrush" Value="#6F8F78" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="9,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <TextBlock x:Name="Placeholder" Margin="{TemplateBinding Padding}" Padding="2,0,0,0"
                                       Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                       Foreground="{StaticResource FaintTextBrush}" Visibility="Collapsed" IsHitTestVisible="False" />
                            <!-- TextBox applies Padding to its text by itself: no extra margin here -->
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentLineBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Borderless multi-line field inside a note card -->
    <Style x:Key="NoteBox" TargetType="TextBox" BasedOn="{StaticResource InputBox}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,2" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="AcceptsTab" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="MaxHeight" Value="260" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <!-- A row of choices sits in a sunken track; the chosen one is raised -->
    <Style x:Key="SegmentTrack" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SunkenBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="Segment" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="7" Padding="11,4" Background="Transparent"
                            BorderBrush="Transparent" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SocketFillBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A group of settings or a list row -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

    <Style x:Key="ListCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12,9,6,9" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#1D1C19" />
                <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Slim dark scroll bar everywhere -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border x:Name="Bar" CornerRadius="3" Margin="1" Background="#34322D" />
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bar" Property="Background" Value="#4A4741" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource SmallFont}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="#1C1B18" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="8,4">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
