<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Palette: flat charcoal, monochrome. No gradients, no glow.
        "On" and the main action are drawn in near-white; colour is kept for meaning only:
        green = done/fine, amber = working/attention, red = danger.
    -->
    <Color x:Key="InkColor">#0A0A0B</Color>
    <Color x:Key="WindowColor">#111113</Color>
    <Color x:Key="HairlineColor">#26262B</Color>
    <Color x:Key="TextColor">#EDEDEF</Color>

    <SolidColorBrush x:Key="IslandBrush" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="IslandBorderBrush" Color="#222226" />
    <SolidColorBrush x:Key="IslandEdgeBrush" Color="#232327" />
    <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource WindowColor}" />
    <SolidColorBrush x:Key="SunkenBrush" Color="#0C0C0E" />
    <SolidColorBrush x:Key="TileBrush" Color="#151517" />
    <SolidColorBrush x:Key="CardBrush" Color="#18181B" />
    <SolidColorBrush x:Key="TileHoverBrush" Color="#202024" />
    <SolidColorBrush x:Key="PressedBrush" Color="#1B1B1E" />
    <SolidColorBrush x:Key="DividerBrush" Color="#222226" />
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource HairlineColor}" />
    <SolidColorBrush x:Key="LineStrongBrush" Color="#38383F" />

    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#9A9AA2" />
    <SolidColorBrush x:Key="FaintTextBrush" Color="#5E5E66" />

    <!-- Accent = near-white on charcoal. Fill/line variants stay dark so text on them reads well. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#EDEDEF" />
    <SolidColorBrush x:Key="AccentFillBrush" Color="#26262B" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#2F2F35" />
    <SolidColorBrush x:Key="AccentLineBrush" Color="#4A4A52" />

    <SolidColorBrush x:Key="OkBrush" Color="#7BC79A" />
    <SolidColorBrush x:Key="WarnBrush" Color="#E2B05E" />
    <SolidColorBrush x:Key="DangerBrush" Color="#E5806E" />
    <SolidColorBrush x:Key="BusyBrush" Color="#E2B05E" />

    <!-- Key cap that holds a module's icon: flat -->
    <SolidColorBrush x:Key="SocketFillBrush" Color="#1E1E22" />
    <SolidColorBrush x:Key="SocketEdgeBrush" Color="#2C2C32" />

    <!-- Segoe UI Variable comes with Windows 11; Windows 10 falls back to Segoe UI -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="SmallFont">Segoe UI Variable Small, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- The Wipriss mark, same geometry as assets/logo/wipriss.svg -->
    <GeometryGroup x:Key="LogoGeometry" FillRule="Nonzero">
        <RectangleGeometry Rect="112,112,288,288" RadiusX="30" RadiusY="30" />
        <RectangleGeometry Rect="624,112,288,288" RadiusX="30" RadiusY="30" />
        <RectangleGeometry Rect="112,624,288,288" RadiusX="30" RadiusY="30" />
        <RectangleGeometry Rect="624,624,288,288" RadiusX="30" RadiusY="30" />
        <RectangleGeometry Rect="492,306,40,412" />
        <RectangleGeometry Rect="306,492,412,40" />
        <RectangleGeometry Rect="402,402,220,220" RadiusX="34" RadiusY="34" />
    </GeometryGroup>

    <!-- The Claude mark (a simple 8-ray asterisk drawn here, not the official artwork) -->
    <Geometry x:Key="AgentGeometry">M12,1.5 L13.2,9.1 L19.4,4.6 L14.9,10.8 L22.5,12 L14.9,13.2 L19.4,19.4 L13.2,14.9 L12,22.5 L10.8,14.9 L4.6,19.4 L9.1,13.2 L1.5,12 L9.1,10.8 L4.6,4.6 L10.8,9.1 Z</Geometry>
    <SolidColorBrush x:Key="AgentBrush" Color="#D97757" />

    <!-- Text roles -->
    <Style x:Key="PanelTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SmallFont}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--
        A module's icon in a small flat cap. IsEnabled="False" draws an empty slot instead:
        the module is planned but not built yet.
    -->
    <Style x:Key="Socket" TargetType="ContentControl">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border x:Name="Cap" CornerRadius="7" BorderThickness="1"
                                Background="{StaticResource SocketFillBrush}" BorderBrush="{StaticResource SocketEdgeBrush}" />
                        <Rectangle x:Name="Slot" RadiusX="7" RadiusY="7" Stroke="{StaticResource LineStrongBrush}"
                                   StrokeThickness="1" StrokeDashArray="2.5 2" Visibility="Collapsed" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Cap" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Slot" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource FaintTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Width="30" Height="30" CornerRadius="7" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource TileHoverBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource PressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PlainButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="7" Padding="13,6" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource TileHoverBrush}" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource PressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The one main action on a panel: a light button, the only bright surface in the app -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource PlainButton}">
        <Setter Property="Foreground" Value="#111113" />
        <Setter Property="Background" Value="#EDEDEF" />
        <Setter Property="BorderBrush" Value="#EDEDEF" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="7" Padding="13,6" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#D6D6DA" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A confirmed destructive action, like ending a program -->
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PlainButton}">
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
        <Setter Property="Background" Value="#24171A" />
        <Setter Property="BorderBrush" Value="#4A2B2A" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="7" Padding="13,6" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#2E1C1E" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#24171A" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TileBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource TileBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="Padding" Value="10,9" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource TileHoverBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        CheckBox drawn as an on/off switch. The thumb slides (render transform, no re-layout)
        and the colours cross-fade, both in 160 ms. Fixed sizes, so nothing jumps.
        Long labels wrap instead of running under the switch.
    -->
    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter VerticalAlignment="Center" Margin="0,0,14,0">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                        <Grid Grid.Column="1" Width="38" Height="22" VerticalAlignment="Center">
                            <Border x:Name="Track" CornerRadius="11" BorderThickness="1">
                                <Border.Background>
                                    <SolidColorBrush x:Name="TrackFill" Color="#1E1E22" />
                                </Border.Background>
                                <Border.BorderBrush>
                                    <SolidColorBrush x:Name="TrackEdge" Color="#3A3A41" />
                                </Border.BorderBrush>
                            </Border>
                            <Ellipse x:Name="Thumb" Width="14" Height="14" HorizontalAlignment="Left" Margin="4,0,0,0">
                                <Ellipse.Fill>
                                    <SolidColorBrush x:Name="ThumbFill" Color="#8A8A92" />
                                </Ellipse.Fill>
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="ThumbShift" X="0" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbShift" Storyboard.TargetProperty="X"
                                                         To="16" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <ColorAnimation Storyboard.TargetName="TrackFill" Storyboard.TargetProperty="Color" To="#EDEDEF" Duration="0:0:0.16" />
                                        <ColorAnimation Storyboard.TargetName="TrackEdge" Storyboard.TargetProperty="Color" To="#EDEDEF" Duration="0:0:0.16" />
                                        <ColorAnimation Storyboard.TargetName="ThumbFill" Storyboard.TargetProperty="Color" To="#111113" Duration="0:0:0.16" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbShift" Storyboard.TargetProperty="X"
                                                         To="0" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <ColorAnimation Storyboard.TargetName="TrackFill" Storyboard.TargetProperty="Color" To="#1E1E22" Duration="0:0:0.16" />
                                        <ColorAnimation Storyboard.TargetName="TrackEdge" Storyboard.TargetProperty="Color" To="#3A3A41" Duration="0:0:0.16" />
                                        <ColorAnimation Storyboard.TargetName="ThumbFill" Storyboard.TargetProperty="Color" To="#8A8A92" Duration="0:0:0.16" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text field with a placeholder taken from Tag -->
    <Style x:Key="InputBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource SunkenBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
        <Setter Property="SelectionBrush" Value="#5B6B86" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="9,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" CornerRadius="7" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <TextBlock x:Name="Placeholder" Margin="{TemplateBinding Padding}" Padding="2,0,0,0"
                                       Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                       Foreground="{StaticResource FaintTextBrush}" Visibility="Collapsed" IsHitTestVisible="False"
                                       TextTrimming="CharacterEllipsis" />
                            <!-- TextBox applies Padding to its text by itself: no extra margin here -->
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#6E6E78" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Borderless multi-line field inside a note card -->
    <Style x:Key="NoteBox" TargetType="TextBox" BasedOn="{StaticResource InputBox}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,2" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="AcceptsTab" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="MaxHeight" Value="260" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <!-- A row of choices sits in a sunken track; the chosen one is raised -->
    <Style x:Key="SegmentTrack" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SunkenBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="Segment" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="6" Padding="11,4" Background="Transparent"
                            BorderBrush="Transparent" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#26262B" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A group of settings or a list row -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <Style x:Key="ListCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="12,9,6,9" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#1C1C20" />
                <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A left-hand navigation item in the settings window -->
    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="7" Padding="10,7" Background="Transparent">
                        <DockPanel>
                            <TextBlock x:Name="Glyph" DockPanel.Dock="Left" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                       FontFamily="{StaticResource IconFont}" FontSize="14" Width="18" Margin="0,0,10,0"
                                       VerticalAlignment="Center" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#18181B" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#202024" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- One row inside a settings card: title + optional hint on the left, a control on the right -->
    <Style x:Key="RowTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Slim dark scroll bar everywhere -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border x:Name="Bar" CornerRadius="3" Margin="1" Background="#303036" />
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bar" Property="Background" Value="#46464E" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource SmallFont}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="#1C1C20" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="8,4" MaxWidth="320">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
