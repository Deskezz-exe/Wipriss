<Window x:Class="Wipriss.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wipriss · Настройки"
        Width="460" SizeToContent="Height" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True">

    <StackPanel Margin="22,16,22,20">

        <TextBlock Text="Островок" Style="{StaticResource SectionTitle}" Margin="2,0,0,8" />
        <Border Style="{StaticResource Card}" Padding="16,4">
            <StackPanel>
                <CheckBox x:Name="HideInFullscreenToggle" Style="{StaticResource ToggleSwitch}" Margin="0,9"
                          Content="Скрывать, когда игра или видео на весь экран" />
                <Border Height="1" Background="{StaticResource DividerBrush}" />
                <CheckBox x:Name="AutostartToggle" Style="{StaticResource ToggleSwitch}" Margin="0,9"
                          Content="Запускать вместе с Windows" />
            </StackPanel>
        </Border>

        <TextBlock Text="Модули" Style="{StaticResource SectionTitle}" Margin="2,22,0,2" />
        <TextBlock Text="Выключенный модуль не загружается вообще и не тратит память."
                   Style="{StaticResource Caption}" Margin="2,0,0,8" />
        <Border Style="{StaticResource Card}" Padding="14,4">
            <ItemsControl x:Name="ModuleList" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Style="{StaticResource ToggleSwitch}" Margin="0,7" IsChecked="{Binding Enabled, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl Style="{StaticResource Socket}" Content="{Binding Info.Glyph}" Width="26" Height="26"
                                                FontSize="13" IsEnabled="{Binding Built}" VerticalAlignment="Center" />
                                <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Info.Title}" />
                                    <TextBlock Text="{Binding Subtitle}" FontFamily="{StaticResource SmallFont}" FontSize="11"
                                               Foreground="{StaticResource SubtleTextBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </CheckBox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <DockPanel Margin="2,18,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource PlainButton}" Content="Выйти из Wipriss" Click="Exit_Click" />
            <TextBlock x:Name="VersionText" VerticalAlignment="Center" FontFamily="{StaticResource SmallFont}" FontSize="11.5"
                       Foreground="{StaticResource FaintTextBrush}" />
        </DockPanel>
    </StackPanel>
</Window>
