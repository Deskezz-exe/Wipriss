<Window x:Class="Wipriss.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки Wipriss"
        Width="820" Height="600" MinWidth="680" MinHeight="460" WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sections -->
        <Border Background="#0E0E10" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,16,12,14">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,18">
                    <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                        <Path Data="{StaticResource LogoGeometry}" Fill="{StaticResource TextBrush}" />
                    </Viewbox>
                    <TextBlock Text="Wipriss" Margin="10,0,0,1" FontFamily="{StaticResource DisplayFont}" FontSize="15"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="VersionText" DockPanel.Dock="Bottom" Margin="10,0,0,0" FontFamily="{StaticResource SmallFont}"
                           FontSize="11.5" Foreground="{StaticResource FaintTextBrush}" />
                <StackPanel x:Name="Nav" />
            </DockPanel>
        </Border>

        <!-- The chosen section -->
        <ScrollViewer x:Name="PageScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <StackPanel x:Name="Page" Margin="32,22,32,28" MaxWidth="640" HorizontalAlignment="Stretch" />
        </ScrollViewer>
    </Grid>
</Window>
