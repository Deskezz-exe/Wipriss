<Window x:Class="Wipriss.App.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wipriss"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        Width="620" Height="304" UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}">

    <!--
        The window is bigger than the pill; its transparent part lets clicks through.
        The island's outline is one animated rounded rectangle (set up in code): it fills the
        surface through a clip and draws the edge. Changing it only redraws, it never re-lays out
        the content, which is what keeps the animation smooth.
    -->
    <Grid x:Name="Island" Width="612" Height="294" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"
          MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave"
          AllowDrop="True" DragEnter="Island_DragEnter" DragOver="Island_DragOver" DragLeave="Island_DragLeave"
          Drop="Island_Drop">

        <Grid x:Name="Surface" Background="{StaticResource IslandBrush}">

            <!-- Closed: the modules' blocks in a row (set up in code), or for a moment one wider message -->
            <Grid x:Name="CollapsedContent" Height="34" HorizontalAlignment="Center" VerticalAlignment="Top"
                  IsHitTestVisible="False">
                <StackPanel x:Name="PillRow" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" />
                <ContentControl x:Name="PeekHost" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0" Focusable="False" />
            </Grid>

            <Grid x:Name="ExpandedContent" Width="568" Height="262" Margin="0,12,0,0"
                  HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0" IsHitTestVisible="False" Visibility="Collapsed">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="ExpandedShift" Y="-6" />
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Margin="6,0,2,0">
                    <Viewbox Width="14" Height="14" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <Path Data="{StaticResource LogoGeometry}" Fill="{StaticResource TextBrush}" />
                    </Viewbox>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE713;"
                            ToolTip="Настройки" Click="Settings_Click" />
                    <TextBlock x:Name="ClockText" DockPanel.Dock="Right" Margin="0,0,10,1" VerticalAlignment="Center"
                               FontFamily="{StaticResource SmallFont}" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" />
                    <TextBlock Text="Wipriss" Margin="9,0,0,1" FontFamily="{StaticResource DisplayFont}" FontSize="14"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>

                <!-- Live cards from modules; an empty home screen shows the date -->
                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <UniformGrid x:Name="Cards" Rows="1" />
                    <StackPanel x:Name="EmptyHome" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="BigClock" FontFamily="{StaticResource DisplayFont}" FontSize="40" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Name="DateText" Margin="0,0,0,0" FontSize="13" Foreground="{StaticResource SubtleTextBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- The dock: modules opened by a click. Files dropped on a button go to that module. -->
                <ItemsControl x:Name="Tiles" Grid.Row="2" Margin="0,10,0,0" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Tile" Height="56" Margin="1,0" CornerRadius="10" Background="Transparent"
                                    Cursor="{Binding Cursor}" MouseLeftButtonUp="Tile_Click">
                                <Border.ToolTip>
                                    <ToolTip>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Description}" />
                                            <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource SubtleTextBrush}" />
                                        </StackPanel>
                                    </ToolTip>
                                </Border.ToolTip>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="GlyphText" Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="17"
                                               HorizontalAlignment="Center" />
                                    <TextBlock x:Name="TitleText" Text="{Binding Title}" Margin="0,6,0,0" FontFamily="{StaticResource SmallFont}"
                                               FontSize="11" Foreground="{StaticResource SubtleTextBrush}" HorizontalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Tile" Property="Background" Value="{StaticResource TileHoverBrush}" />
                                    <Setter TargetName="TitleText" Property="Foreground" Value="{StaticResource TextBrush}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsReady}" Value="False">
                                    <Setter TargetName="GlyphText" Property="Foreground" Value="{StaticResource FaintTextBrush}" />
                                    <Setter TargetName="TitleText" Property="Foreground" Value="{StaticResource FaintTextBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>

        <Path x:Name="Edge" Stroke="{StaticResource IslandEdgeBrush}" StrokeThickness="1" IsHitTestVisible="False" />
    </Grid>
</Window>
