<Window x:Class="Wipriss.App.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wipriss"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        Width="620" Height="46" UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}">

    <!--
        The window is bigger than the pill; its transparent part lets clicks through.
        The island's outline is one animated rounded rectangle (set up in code): it fills the
        surface through a clip and draws the edge. Changing it only redraws, it never re-lays out
        the content, which is what keeps the animation smooth. The open island is as tall as its cards.
    -->
    <Grid x:Name="Island" Width="612" Height="40" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"
          MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave"
          AllowDrop="True" DragEnter="Island_DragEnter" DragOver="Island_DragOver" DragLeave="Island_DragLeave"
          Drop="Island_Drop">

        <Grid x:Name="Surface" Background="{StaticResource IslandBrush}">

            <!-- Closed: the modules' blocks in a row (set up in code), or for a moment one wider message -->
            <Grid x:Name="CollapsedContent" Height="34" HorizontalAlignment="Center" VerticalAlignment="Top"
                  IsHitTestVisible="False">
                <StackPanel x:Name="PillRow" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" />
                <ContentControl x:Name="PeekHost" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0" Focusable="False" />
            </Grid>

            <Grid x:Name="ExpandedContent" Width="920" Margin="0,18,0,0"
                  HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0" IsHitTestVisible="False" Visibility="Collapsed">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="ExpandedShift" Y="-6" />
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Top row: the dock on the left; figures in the middle; devices and settings on the right -->
                <DockPanel>
                    <Border DockPanel.Dock="Left" Background="{StaticResource SocketFillBrush}" CornerRadius="16" Padding="5"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <!-- Home: active unless a module's panel is open; a click closes that panel -->
                            <Border x:Name="HomeTab" Width="38" Height="32" CornerRadius="11" Cursor="Hand" ToolTip="Главный экран"
                                    MouseLeftButtonUp="Home_Click">
                                <TextBlock x:Name="HomeGlyph" Text="&#xE80F;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ItemsControl x:Name="Tiles" Focusable="False" Margin="2,0,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Tile" Width="38" Height="32" Margin="2,0,0,0" CornerRadius="11" Background="Transparent"
                                                Cursor="{Binding Cursor}" MouseLeftButtonUp="Tile_Click">
                                            <Border.ToolTip>
                                                <ToolTip>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Description}" />
                                                        <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource SubtleTextBrush}" />
                                                    </StackPanel>
                                                </ToolTip>
                                            </Border.ToolTip>
                                            <TextBlock x:Name="GlyphText" Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="15"
                                                       Foreground="{StaticResource SubtleTextBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Tile" Property="Background" Value="{StaticResource TileHoverBrush}" />
                                                <Setter TargetName="GlyphText" Property="Foreground" Value="{StaticResource TextBrush}" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter TargetName="Tile" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                                                <Setter TargetName="GlyphText" Property="Foreground" Value="{StaticResource TextBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsReady}" Value="False">
                                                <Setter TargetName="GlyphText" Property="Foreground" Value="{StaticResource FaintTextBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Settings: a round button, the same height as the dock -->
                    <Border x:Name="SettingsButton" DockPanel.Dock="Right" Width="42" Height="42" CornerRadius="21"
                            Background="{StaticResource SocketFillBrush}" Cursor="Hand" ToolTip="Настройки"
                            MouseLeftButtonUp="Settings_Click" VerticalAlignment="Center">
                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="18"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ContentControl x:Name="DeviceHost" DockPanel.Dock="Right" Margin="0,0,16,0" VerticalAlignment="Center" Focusable="False" />
                    <ContentControl x:Name="StatusHost" Margin="18,0,14,0" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False" />
                </DockPanel>

                <!-- Live cards from modules: the big one on the left, the right column grows with its cards -->
                <Grid x:Name="Home" Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="LeftColumn" Width="420" />
                        <ColumnDefinition x:Name="GapColumn" Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: the to-do list (a fixed height, it scrolls inside) and the timer under it -->
                    <StackPanel x:Name="SideColumn">
                        <ContentControl x:Name="SideMiddleCard" Focusable="False" />
                        <ContentControl x:Name="SideTopCard" Focusable="False" Margin="0,12,0,0" />
                    </StackPanel>

                    <!-- Right: music and video (fills the height), the agents under it -->
                    <Grid x:Name="RightColumn" Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid x:Name="MainHost" MinHeight="210">
                            <!-- Nothing plays: the time and date -->
                            <Border x:Name="EmptyMain" Background="{StaticResource TileBrush}" BorderBrush="{StaticResource DividerBrush}"
                                    BorderThickness="1" CornerRadius="18">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock x:Name="BigClock" FontFamily="{StaticResource DisplayFont}" FontSize="56" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" />
                                    <TextBlock x:Name="DateText" FontSize="14" Foreground="{StaticResource SubtleTextBrush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ContentControl x:Name="MainCard" Focusable="False" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch" />
                        </Grid>
                        <ContentControl x:Name="SideCard" Grid.Row="1" Focusable="False" Margin="0,12,0,0" />
                    </Grid>
                </Grid>

                <!-- A dock tab that opens right here (the clipboard and notes): its modules' parts side by side,
                     as tall as the home screen was, so the island keeps its size -->
                <Grid x:Name="Page" Grid.Row="2" Visibility="Collapsed" />
            </Grid>
        </Grid>

        <Path x:Name="Edge" Stroke="{StaticResource IslandEdgeBrush}" StrokeThickness="1" IsHitTestVisible="False" />
    </Grid>
</Window>
