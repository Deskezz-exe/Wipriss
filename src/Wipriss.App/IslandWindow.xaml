<Window x:Class="Wipriss.App.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wipriss"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        Width="780" Height="344" UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}">

    <!--
        The window is bigger than the pill; its transparent part lets clicks through.
        The island's outline is one animated rounded rectangle (set up in code): it fills the
        surface through a clip and draws the edge. Changing it only redraws, it never re-lays out
        the content, which is what keeps the animation smooth.
    -->
    <Grid x:Name="Island" Width="772" Height="338" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"
          MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave"
          AllowDrop="True" DragEnter="Island_DragEnter" DragOver="Island_DragOver" DragLeave="Island_DragLeave"
          Drop="Island_Drop">

        <Grid x:Name="Surface" Background="{StaticResource IslandBrush}">

            <!-- Closed: the modules' blocks in a row (set up in code), or for a moment one wider message -->
            <Grid x:Name="CollapsedContent" Height="34" HorizontalAlignment="Center" VerticalAlignment="Top"
                  IsHitTestVisible="False">
                <StackPanel x:Name="PillRow" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" />
                <ContentControl x:Name="PeekHost" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0" Focusable="False" />
            </Grid>

            <Grid x:Name="ExpandedContent" Width="724" Height="294" Margin="0,14,0,0"
                  HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0" IsHitTestVisible="False" Visibility="Collapsed">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="ExpandedShift" Y="-6" />
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Top row: the dock of modules on the left; figures, clock and settings on the right -->
                <DockPanel>
                    <Border DockPanel.Dock="Left" Background="{StaticResource SocketFillBrush}" CornerRadius="14" Padding="4"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <!-- Home: where we are; the module buttons follow. Files dropped on a button go to that module. -->
                            <Border Width="38" Height="30" CornerRadius="10" Background="{StaticResource AccentHoverBrush}" ToolTip="Главный экран">
                                <Viewbox Width="14" Height="14">
                                    <Path Data="{StaticResource LogoGeometry}" Fill="{StaticResource TextBrush}" />
                                </Viewbox>
                            </Border>
                            <ItemsControl x:Name="Tiles" Focusable="False" Margin="2,0,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Tile" Width="38" Height="30" Margin="2,0,0,0" CornerRadius="10" Background="Transparent"
                                                Cursor="{Binding Cursor}" MouseLeftButtonUp="Tile_Click">
                                            <Border.ToolTip>
                                                <ToolTip>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Description}" />
                                                        <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource SubtleTextBrush}" />
                                                    </StackPanel>
                                                </ToolTip>
                                            </Border.ToolTip>
                                            <TextBlock x:Name="GlyphText" Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="15"
                                                       Foreground="{StaticResource SubtleTextBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Tile" Property="Background" Value="{StaticResource TileHoverBrush}" />
                                                <Setter TargetName="GlyphText" Property="Foreground" Value="{StaticResource TextBrush}" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsReady}" Value="False">
                                                <Setter TargetName="GlyphText" Property="Foreground" Value="{StaticResource FaintTextBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE713;" VerticalAlignment="Center"
                            ToolTip="Настройки" Click="Settings_Click" />
                    <TextBlock x:Name="ClockText" DockPanel.Dock="Right" Margin="14,0,8,1" VerticalAlignment="Center"
                               FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="SemiBold" />
                    <ContentControl x:Name="StatusHost" DockPanel.Dock="Right" VerticalAlignment="Center" Focusable="False" />
                    <Border />
                </DockPanel>

                <!-- Live cards from modules: the big one on the left, short ones on the right -->
                <Grid x:Name="Home" Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="MainColumn" Width="336" />
                        <ColumnDefinition x:Name="GapColumn" Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="MainHost">
                        <!-- Nothing plays: the time and date -->
                        <Border x:Name="EmptyMain" Background="{StaticResource TileBrush}" BorderBrush="{StaticResource DividerBrush}"
                                BorderThickness="1" CornerRadius="18">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="BigClock" FontFamily="{StaticResource DisplayFont}" FontSize="52" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:Name="DateText" FontSize="13.5" Foreground="{StaticResource SubtleTextBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ContentControl x:Name="MainCard" Focusable="False" />
                    </Grid>

                    <Grid x:Name="SideColumn" Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ContentControl x:Name="SideTopCard" Focusable="False" Height="104" />
                        <Border x:Name="SideGap" Grid.Row="1" Height="10" />
                        <ContentControl x:Name="SideCard" Grid.Row="2" Focusable="False" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <Path x:Name="Edge" Stroke="{StaticResource IslandEdgeBrush}" StrokeThickness="1" IsHitTestVisible="False" />
    </Grid>
</Window>
