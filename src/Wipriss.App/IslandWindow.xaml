<Window x:Class="Wipriss.App.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wipriss"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        Width="620" Height="280" UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}">

    <!--
        The window is bigger than the pill; its transparent part lets clicks through.
        The island's outline is one animated rounded rectangle (set up in code): it fills the
        surface through a clip and draws the edge. Changing it only redraws, it never re-lays out
        the tiles, which is what keeps the animation smooth.
    -->
    <Grid x:Name="Island" Width="612" Height="268" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"
          MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave">

        <Grid x:Name="Surface" Background="{StaticResource IslandBrush}">
            <Viewbox x:Name="CollapsedContent" Width="14" Height="14" Margin="0,10,0,0"
                     HorizontalAlignment="Center" VerticalAlignment="Top" IsHitTestVisible="False">
                <Path Data="{StaticResource LogoGeometry}" Fill="{StaticResource TextBrush}" />
            </Viewbox>

            <Grid x:Name="ExpandedContent" Width="564" Height="232" Margin="0,13,0,0"
                  HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0" IsHitTestVisible="False">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="ExpandedShift" Y="-6" />
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Margin="4,0,4,0">
                    <Viewbox Width="14" Height="14" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <Path Data="{StaticResource LogoGeometry}" Fill="{StaticResource TextBrush}" />
                    </Viewbox>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE713;"
                            ToolTip="Настройки" Click="Settings_Click" />
                    <TextBlock Text="Wipriss" Margin="9,0,0,1" FontFamily="{StaticResource DisplayFont}" FontSize="14"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>

                <ItemsControl x:Name="Tiles" Grid.Row="1" Margin="0,6,0,0" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="5" VerticalAlignment="Top" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Tile" Style="{StaticResource TileBorder}" Height="90" ToolTip="{Binding Description}"
                                    Cursor="{Binding Cursor}" MouseLeftButtonUp="Tile_Click">
                                <StackPanel>
                                    <ContentControl Style="{StaticResource Socket}" Content="{Binding Glyph}" HorizontalAlignment="Left"
                                                    IsEnabled="{Binding IsReady}" />
                                    <TextBlock x:Name="TitleText" Text="{Binding Title}" Margin="1,7,0,0" FontSize="12.5"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="SubtitleText" Text="{Binding Subtitle}" Margin="1,1,0,0"
                                               FontFamily="{StaticResource SmallFont}" FontSize="11"
                                               Foreground="{StaticResource SubtleTextBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <!-- Planned module: an empty slot, quieter than the ready ones -->
                                <DataTrigger Binding="{Binding IsReady}" Value="False">
                                    <Setter TargetName="Tile" Property="Background" Value="Transparent" />
                                    <Setter TargetName="Tile" Property="BorderBrush" Value="#191816" />
                                    <Setter TargetName="TitleText" Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
                                    <Setter TargetName="SubtitleText" Property="Foreground" Value="{StaticResource FaintTextBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>

        <Path x:Name="Edge" Stroke="{StaticResource IslandEdgeBrush}" StrokeThickness="1" IsHitTestVisible="False" />
    </Grid>
</Window>
