<Window x:Class="Wipriss.App.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wipriss"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        Width="600" Height="280" UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}">

    <!-- The window is bigger than the pill; its transparent part lets clicks through. -->
    <Grid>
        <Border x:Name="Pill" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"
                Width="132" Height="34" CornerRadius="17" ClipToBounds="True"
                Background="{StaticResource IslandBrush}" BorderBrush="{StaticResource IslandBorderBrush}" BorderThickness="1"
                MouseEnter="Pill_MouseEnter" MouseLeave="Pill_MouseLeave">
            <Grid>
                <Viewbox x:Name="CollapsedContent" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Data="{StaticResource LogoGeometry}" Fill="{StaticResource TextBrush}" />
                </Viewbox>

                <Grid x:Name="ExpandedContent" Width="512" Height="214" Margin="0,12,0,0"
                      HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Margin="4,0,0,0">
                        <Viewbox Width="16" Height="16" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <Path Data="{StaticResource LogoGeometry}" Fill="{StaticResource TextBrush}" />
                        </Viewbox>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE713;"
                                ToolTip="Настройки" Click="Settings_Click" />
                        <TextBlock Text="Wipriss" Margin="10,0,0,0" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>

                    <ItemsControl x:Name="Tiles" Grid.Row="1" Margin="0,10,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="5" VerticalAlignment="Top" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource TileBorder}" Height="80" ToolTip="{Binding Description}"
                                        Opacity="{Binding Opacity}" Cursor="{Binding Cursor}" MouseLeftButtonUp="Tile_Click">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="18" />
                                        <TextBlock Text="{Binding Title}" Margin="0,8,0,0" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}" Margin="0,2,0,0" FontSize="10.5"
                                                   Foreground="{StaticResource SubtleTextBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
