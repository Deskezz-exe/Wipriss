<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 10.0.19041 for the media card's WinRT API; still runs on Windows 10 1809 and newer -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <AssemblyName>Wipriss</AssemblyName>
    <RootNamespace>Wipriss.App</RootNamespace>
    <ApplicationIcon>Assets\wipriss.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Low memory: workstation GC without the background GC thread -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ask the GC to compact more aggressively instead of growing the heap -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wipriss.Core\Wipriss.Core.csproj" />
    <ProjectReference Include="..\Modules\Wipriss.Modules.Agents\Wipriss.Modules.Agents.csproj" />
    <ProjectReference Include="..\Modules\Wipriss.Modules.Media\Wipriss.Modules.Media.csproj" />
    <ProjectReference Include="..\Modules\Wipriss.Modules.Load\Wipriss.Modules.Load.csproj" />
    <ProjectReference Include="..\Modules\Wipriss.Modules.Timer\Wipriss.Modules.Timer.csproj" />
    <ProjectReference Include="..\Modules\Wipriss.Modules.Todo\Wipriss.Modules.Todo.csproj" />
    <ProjectReference Include="..\Modules\Wipriss.Modules.Batteries\Wipriss.Modules.Batteries.csproj" />
    <ProjectReference Include="..\Modules\Wipriss.Modules.Notes\Wipriss.Modules.Notes.csproj" />
    <ProjectReference Include="..\Modules\Wipriss.Modules.ClipboardHistory\Wipriss.Modules.ClipboardHistory.csproj" />
    <ProjectReference Include="..\Modules\Wipriss.Modules.Reminders\Wipriss.Modules.Reminders.csproj" />
    <ProjectReference Include="..\Modules\Wipriss.Modules.Network\Wipriss.Modules.Network.csproj" />
    <ProjectReference Include="..\Modules\Wipriss.Modules.Ports\Wipriss.Modules.Ports.csproj" />
    <ProjectReference Include="..\Modules\Wipriss.Modules.Capture\Wipriss.Modules.Capture.csproj" />
    <ProjectReference Include="..\Modules\Wipriss.Modules.Converter\Wipriss.Modules.Converter.csproj" />
    <!-- The one-shot picture converter ships next to Wipriss.exe (Magick.NET loads only there) -->
    <ProjectReference Include="..\Wipriss.Converter\Wipriss.Converter.csproj" />
    <ProjectReference Include="..\Modules\Wipriss.Modules.Tables\Wipriss.Modules.Tables.csproj" />
    <ProjectReference Include="..\Modules\Wipriss.Modules.Voice\Wipriss.Modules.Voice.csproj" />
    <!-- The table viewer ships next to Wipriss.exe (a separate process: tables never load into the island) -->
    <ProjectReference Include="..\Wipriss.Reader\Wipriss.Reader.csproj" />
    <!-- The voice typing engine ships next to Wipriss.exe (sherpa-onnx and the model load only there) -->
    <ProjectReference Include="..\Wipriss.Voice\Wipriss.Voice.csproj" />
    <ProjectReference Include="..\Modules\Wipriss.Modules.Cleaner\Wipriss.Modules.Cleaner.csproj" />
    <!-- The cleaner's scanner ships next to Wipriss.exe (one search per process, then it exits) -->
    <ProjectReference Include="..\Wipriss.Cleaner\Wipriss.Cleaner.csproj" />
    <!-- The agents' hook ships next to Wipriss.exe (Claude Code and Codex run it, it exits at once) -->
    <ProjectReference Include="..\Wipriss.AgentHook\Wipriss.AgentHook.csproj" />
    <!-- The one-shot admin helper ships next to Wipriss.exe -->
    <ProjectReference Include="..\Wipriss.Helper\Wipriss.Helper.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\tray-light.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\tray-dark.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The Windows 11 Explorer menu (native DLL + unsigned sparse package), built beforehand by
       tools\build-explorer-menu.ps1 into artifacts\.cache\explorer-menu, goes next to the published Wipriss.exe. -->
  <PropertyGroup>
    <ExplorerMenuDir>$(MSBuildThisFileDirectory)..\..\artifacts\.cache\explorer-menu\</ExplorerMenuDir>
  </PropertyGroup>
  <Target Name="CopyExplorerMenu" AfterTargets="Publish">
    <Warning Condition="!Exists('$(ExplorerMenuDir)WiprissExplorerMenu.msix')"
             Text="Explorer menu not built: run tools\build-explorer-menu.ps1 first (the classic menu still works)." />
    <Copy Condition="Exists('$(ExplorerMenuDir)WiprissExplorerMenu.msix')"
          SourceFiles="$(ExplorerMenuDir)WiprissExplorerMenu.dll;$(ExplorerMenuDir)WiprissExplorerMenu.msix" DestinationFolder="$(PublishDir)" />
  </Target>

</Project>
