<UserControl x:Class="Wipriss.Modules.Processes.ProcessesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Border DockPanel.Dock="Right" Style="{StaticResource SegmentTrack}" Margin="8,0,0,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Segment}" GroupName="ProcSort" Content="Память" Tag="memory" IsChecked="True"
                                 Checked="Sort_Checked" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="ProcSort" Content="ЦП" Tag="cpu" Checked="Sort_Checked" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="ProcSort" Content="Имя" Tag="name" Checked="Sort_Checked" />
                </StackPanel>
            </Border>
            <TextBox x:Name="SearchBox" Style="{StaticResource InputBox}" Tag="Найти программу" TextChanged="Search_Changed" />
        </DockPanel>

        <Grid DockPanel.Dock="Top" Margin="12,0,7,5" TextElement.FontFamily="{StaticResource SmallFont}"
              TextElement.FontSize="11" TextElement.Foreground="{StaticResource FaintTextBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="66" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Программа" Margin="30,0,0,0" />
            <TextBlock Grid.Column="1" Text="Память" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="2" Text="ЦП" HorizontalAlignment="Right" />
        </Grid>

        <StackPanel DockPanel.Dock="Bottom" Margin="2,10,0,0">
            <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" Margin="0,0,0,6" Visibility="Collapsed" />
            <TextBlock x:Name="TotalText" Style="{StaticResource Caption}" Foreground="{StaticResource FaintTextBrush}" />
        </StackPanel>

        <Grid>
            <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                       Foreground="{StaticResource SubtleTextBrush}" Visibility="Collapsed" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="List" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Card" Style="{StaticResource ListCard}" Padding="11,6,6,6" Margin="0,0,0,4">
                                <StackPanel>
                                    <Grid MinHeight="30">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="66" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="{Binding Icon}" Width="20" Height="20" VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,8,0" VerticalAlignment="Center"
                                                    ToolTip="{Binding Path}">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="190" />
                                            <TextBlock Text="{Binding CountText}" Margin="6,0,0,0" FontFamily="{StaticResource SmallFont}"
                                                       FontSize="11.5" Foreground="{StaticResource FaintTextBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding MemoryText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Typography.NumeralAlignment="Tabular" />
                                        <TextBlock Grid.Column="3" Text="{Binding CpuText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Typography.NumeralAlignment="Tabular" Foreground="{StaticResource SubtleTextBrush}" />
                                        <StackPanel x:Name="Actions" Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right"
                                                    Visibility="Hidden">
                                            <Button Style="{StaticResource IconButton}" Content="&#xE838;" ToolTip="Показать в папке"
                                                    Click="Folder_Click" />
                                            <Button Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Завершить"
                                                    Click="End_Click" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Confirmation: nothing is ended without it -->
                                    <StackPanel x:Name="Confirm" Margin="30,6,4,4" Visibility="Collapsed">
                                        <TextBlock Text="{Binding ConfirmText}" TextWrapping="Wrap" FontSize="12.5" />
                                        <WrapPanel Margin="0,8,0,0">
                                            <Button Style="{StaticResource DangerButton}" Content="{Binding PrimaryText}" FontSize="12"
                                                    Click="Primary_Click" Margin="0,0,6,0" />
                                            <Button Style="{StaticResource PlainButton}" Content="{Binding TreeText}" FontSize="12"
                                                    Visibility="{Binding TreeVisibility}" Click="Tree_Click" Margin="0,0,6,0" />
                                            <Button Style="{StaticResource PlainButton}" Content="Отмена" FontSize="12" Click="Cancel_Click" />
                                        </WrapPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsAsking}" Value="True">
                                    <Setter TargetName="Confirm" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
