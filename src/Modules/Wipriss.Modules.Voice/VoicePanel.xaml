<UserControl x:Class="Wipriss.Modules.Voice.VoicePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <!-- Key -->
        <TextBlock Text="Клавиша" Style="{StaticResource SectionTitle}" Margin="2,0,0,8" />
        <Border Style="{StaticResource Card}" Padding="16,12,16,12">
            <StackPanel>
                <DockPanel>
                    <Button x:Name="ChangeKeyButton" DockPanel.Dock="Right" Style="{StaticResource PlainButton}" Content="Изменить"
                            VerticalAlignment="Center" Click="ChangeKey_Click" />
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock x:Name="KeyText" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="KeyHint" Style="{StaticResource Caption}" Margin="0,3,0,0"
                                   Text="Нажмите — говорите — нажмите ещё раз. Esc отменяет." />
                    </StackPanel>
                </DockPanel>
                <DockPanel Margin="0,10,0,0">
                    <Ellipse x:Name="StateDot" Width="7" Height="7" Margin="1,5,9,0" VerticalAlignment="Top" />
                    <TextBlock x:Name="StateText" Style="{StaticResource Caption}" />
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Models -->
        <TextBlock Text="Модель" Style="{StaticResource SectionTitle}" Margin="2,22,0,8" />
        <ContentControl x:Name="ModelsHost" Focusable="False" />
        <TextBlock Style="{StaticResource Caption}" Margin="2,2,0,0" Foreground="{StaticResource FaintTextBrush}"
                   Text="Работают на этом компьютере без интернета. Голос никуда не отправляется." />

        <!-- Memory -->
        <TextBlock Text="Память" Style="{StaticResource SectionTitle}" Margin="2,22,0,8" />
        <Border Style="{StaticResource SegmentTrack}" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="KeepMode" Style="{StaticResource Segment}" GroupName="Memory" Content="Держать в памяти" Checked="Memory_Changed" />
                <RadioButton x:Name="UnloadMode" Style="{StaticResource Segment}" GroupName="Memory" Content="Выгружать в простое" Checked="Memory_Changed" />
            </StackPanel>
        </Border>
        <StackPanel x:Name="MinutesRow" Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="Через" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="2,0,10,0" />
            <Border Style="{StaticResource SegmentTrack}">
                <StackPanel x:Name="MinutesPanel" Orientation="Horizontal" />
            </Border>
        </StackPanel>
        <TextBlock x:Name="MemoryHint" Style="{StaticResource Caption}" Margin="2,8,0,0" />
    </StackPanel>
</UserControl>
