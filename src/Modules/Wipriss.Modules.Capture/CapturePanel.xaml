<UserControl x:Class="Wipriss.Modules.Capture.CapturePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <!-- Who gets PrtSc -->
        <Border Style="{StaticResource Card}" Padding="16,6,16,12">
            <StackPanel>
                <CheckBox x:Name="OwnKey" Style="{StaticResource ToggleSwitch}" Margin="0,8" Content="Клавиша PrtSc открывает снимок Wipriss"
                          Checked="OwnKey_Changed" Unchecked="OwnKey_Changed" />
                <DockPanel Margin="0,2,0,0">
                    <Ellipse x:Name="StateDot" Width="7" Height="7" Margin="1,5,9,0" VerticalAlignment="Top" />
                    <TextBlock x:Name="StateText" Style="{StaticResource Caption}" />
                </DockPanel>
            </StackPanel>
        </Border>

        <TextBlock Text="Как это работает" Style="{StaticResource SectionTitle}" Margin="2,22,0,8" />
        <Border Style="{StaticResource Card}" Padding="16,12">
            <StackPanel>
                <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource TextBrush}" FontSize="12.5"
                           Text="PrtSc → выделите область, щёлкните по окну, «Весь экран» или «Со скроллом»." />
                <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                           Text="Снимок сразу в буфере: вставьте его через Ctrl+V. В историю буфера он не попадает." />
                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                           Text="На диск — только по кнопке «Сохранить», в папку Wipriss\Скриншоты." />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
