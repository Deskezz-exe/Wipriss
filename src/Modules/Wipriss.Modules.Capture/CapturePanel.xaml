<UserControl x:Class="Wipriss.Modules.Capture.CapturePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <!-- Who gets PrtSc -->
        <Border Style="{StaticResource Card}" Padding="16,6,16,12">
            <StackPanel>
                <CheckBox x:Name="OwnKey" Style="{StaticResource ToggleSwitch}" Margin="0,8" Content="PrtSc открывает Wipriss"
                          Checked="OwnKey_Changed" Unchecked="OwnKey_Changed" />
                <DockPanel Margin="0,2,0,0">
                    <Ellipse x:Name="StateDot" Width="7" Height="7" Margin="1,5,9,0" VerticalAlignment="Top" />
                    <TextBlock x:Name="StateText" Style="{StaticResource Caption}" />
                </DockPanel>
            </StackPanel>
        </Border>

        <TextBlock Text="Как это работает" Style="{StaticResource SectionTitle}" Margin="2,18,0,6" />
        <TextBlock Style="{StaticResource Caption}" Margin="2,0,0,0" LineHeight="18"
                   Text="PrtSc замораживает экран. Дальше: выделите область или щёлкните по окну, «Весь экран», или «Со скроллом», и страница пролистается и склеится сама." />
        <TextBlock Style="{StaticResource Caption}" Margin="2,8,0,0" LineHeight="18"
                   Text="Снимок сразу в буфере: Ctrl+V в любом чате. Он не попадает ни в историю буфера Windows, ни в буфер Wipriss. На диск он ложится только по кнопке «Сохранить» в редакторе, в папку Wipriss\Скриншоты." />
    </StackPanel>
</UserControl>
