<UserControl x:Class="Wipriss.Modules.Capture.CapturePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <!-- The screenshot key -->
        <Border Style="{StaticResource Card}" Padding="0">
            <StackPanel>
                <ContentControl x:Name="KeyHost" />
                <DockPanel x:Name="StateRow" Margin="16,0,16,12">
                    <Ellipse x:Name="StateDot" Width="7" Height="7" Margin="1,5,9,0" VerticalAlignment="Top" />
                    <TextBlock x:Name="StateText" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                </DockPanel>
            </StackPanel>
        </Border>

        <TextBlock Text="Как это работает" Style="{StaticResource SectionTitle}" Margin="2,22,0,8" />
        <Border Style="{StaticResource Card}" Padding="16,12">
            <StackPanel>
                <TextBlock x:Name="HowText" Style="{StaticResource Caption}" Foreground="{StaticResource TextBrush}" FontSize="12.5" TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"
                           Text="Снимок сразу в буфере: вставьте его через Ctrl+V. В историю буфера он не попадает." />
                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="На диск — только по кнопке «Сохранить», в папку Wipriss\Скриншоты." />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
