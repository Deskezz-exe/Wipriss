<UserControl x:Class="Wipriss.Modules.Capture.CapturePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <!-- Is PrtSc ours? -->
        <Border Style="{StaticResource Card}" Padding="14,12">
            <StackPanel>
                <DockPanel>
                    <Ellipse x:Name="StateDot" Width="8" Height="8" Margin="0,1,10,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="StateTitle" FontWeight="SemiBold" TextWrapping="Wrap" />
                </DockPanel>
                <TextBlock x:Name="StateText" Style="{StaticResource Caption}" Margin="18,4,0,0" />
                <Button x:Name="FixButton" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="18,10,0,0"
                        Content="Сделать PrtSc клавишей Wipriss" Click="Fix_Click" Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button Style="{StaticResource PlainButton}" Content="Снять сейчас" Click="Shoot_Click" />
            <Button Style="{StaticResource PlainButton}" Content="Папка скриншотов" Margin="8,0,0,0" Click="Folder_Click" />
        </StackPanel>

        <TextBlock Text="Как это работает" Style="{StaticResource SectionTitle}" Margin="2,18,0,6" />
        <TextBlock Style="{StaticResource Caption}" Margin="2,0,0,0" LineHeight="18"
                   Text="PrtSc замораживает экран. Дальше: выделите область или щёлкните по окну, «Весь экран», или «Со скроллом», и страница пролистается и склеится сама." />
        <TextBlock Style="{StaticResource Caption}" Margin="2,8,0,0" LineHeight="18"
                   Text="Снимок сразу в буфере: Ctrl+V в любом чате. Он не попадает ни в историю буфера Windows, ни в буфер Wipriss. На диск он ложится только по кнопке «Сохранить» в редакторе." />

        <Button x:Name="RestoreButton" Style="{StaticResource PlainButton}" FontSize="12" HorizontalAlignment="Left" Margin="0,16,0,0"
                Content="Вернуть PrtSc «Ножницам» Windows" Click="Restore_Click" Visibility="Collapsed" />
    </StackPanel>
</UserControl>
