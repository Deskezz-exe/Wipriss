<Window x:Class="Wipriss.Modules.Capture.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wipriss · Скриншот"
        WindowStartupLocation="CenterScreen" MinWidth="1080" MinHeight="560"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True">
    <Window.Resources>
        <!-- A colour to draw with -->
        <Style x:Key="Swatch" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Ring" Width="26" Height="26" CornerRadius="13" BorderThickness="2" BorderBrush="Transparent">
                            <Ellipse Width="16" Height="16" Fill="{TemplateBinding Background}" Stroke="#3A3833" StrokeThickness="1" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Tools -->
        <Border DockPanel.Dock="Top" Padding="12,8" Background="#0E0D0C" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource PlainButton}" Content="Копировать" Click="Copy_Click" ToolTip="В буфер обмена (Ctrl+C)" />
                    <Button Style="{StaticResource PrimaryButton}" Content="Сохранить" Click="Save_Click" Margin="6,0,0,0"
                            ToolTip="В папку Wipriss\Скриншоты (Ctrl+S). Без этого снимок не сохраняется на диск" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource SegmentTrack}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="PenTool" Style="{StaticResource Segment}" GroupName="Tool" Content="Кисть" IsChecked="True" Checked="Tool_Checked" />
                            <RadioButton x:Name="MarkerTool" Style="{StaticResource Segment}" GroupName="Tool" Content="Маркер" Checked="Tool_Checked" />
                            <RadioButton x:Name="ArrowTool" Style="{StaticResource Segment}" GroupName="Tool" Content="Стрелка" Checked="Tool_Checked" />
                            <RadioButton x:Name="BoxTool" Style="{StaticResource Segment}" GroupName="Tool" Content="Рамка" Checked="Tool_Checked" />
                            <RadioButton x:Name="BlurTool" Style="{StaticResource Segment}" GroupName="Tool" Content="Размытие" Checked="Tool_Checked"
                                         ToolTip="Спрятать пароль, имя или номер перед отправкой" />
                            <RadioButton x:Name="CropTool" Style="{StaticResource Segment}" GroupName="Tool" Content="Обрезка" Checked="Tool_Checked" />
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="Swatches" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                        <RadioButton Style="{StaticResource Swatch}" GroupName="Color" Background="#E5484D" IsChecked="True" Checked="Color_Checked" ToolTip="Красный" />
                        <RadioButton Style="{StaticResource Swatch}" GroupName="Color" Background="#F5C451" Checked="Color_Checked" ToolTip="Жёлтый" />
                        <RadioButton Style="{StaticResource Swatch}" GroupName="Color" Background="#46A758" Checked="Color_Checked" ToolTip="Зелёный" />
                        <RadioButton Style="{StaticResource Swatch}" GroupName="Color" Background="#3E8EEF" Checked="Color_Checked" ToolTip="Синий" />
                        <RadioButton Style="{StaticResource Swatch}" GroupName="Color" Background="#F2F2F2" Checked="Color_Checked" ToolTip="Белый" />
                        <RadioButton Style="{StaticResource Swatch}" GroupName="Color" Background="#111111" Checked="Color_Checked" ToolTip="Чёрный" />
                    </StackPanel>

                    <Border Style="{StaticResource SegmentTrack}" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" GroupName="Width" Tag="3" Checked="Width_Checked" ToolTip="Тонко">
                                <Ellipse Width="4" Height="4" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </RadioButton>
                            <RadioButton Style="{StaticResource Segment}" GroupName="Width" Tag="6" IsChecked="True" Checked="Width_Checked" ToolTip="Средне">
                                <Ellipse Width="7" Height="7" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </RadioButton>
                            <RadioButton Style="{StaticResource Segment}" GroupName="Width" Tag="12" Checked="Width_Checked" ToolTip="Толсто">
                                <Ellipse Width="11" Height="11" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </RadioButton>
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource IconButton}" Content="&#xE7A7;" Margin="10,0,0,0" Click="Undo_Click" ToolTip="Отменить (Ctrl+Z)" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE7A6;" Click="Redo_Click" ToolTip="Вернуть (Ctrl+Y)" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Size, status -->
        <Border DockPanel.Dock="Bottom" Padding="14,7" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <Button x:Name="ShowFileButton" DockPanel.Dock="Right" Style="{StaticResource PlainButton}" FontSize="12"
                        Content="Показать в папке" Click="ShowFile_Click" Visibility="Collapsed" Margin="8,0,0,0" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Размер при сохранении" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Border Style="{StaticResource SegmentTrack}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" GroupName="Scale" Tag="1" Content="100 %" IsChecked="True" Checked="Scale_Checked" />
                            <RadioButton Style="{StaticResource Segment}" GroupName="Scale" Tag="0.75" Content="75 %" Checked="Scale_Checked" />
                            <RadioButton Style="{StaticResource Segment}" GroupName="Scale" Tag="0.5" Content="50 %" Checked="Scale_Checked" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="InfoText" Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- The picture -->
        <ScrollViewer x:Name="Viewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#0A0A09"
                      Focusable="False">
            <Grid x:Name="Stage" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                <Grid.LayoutTransform>
                    <ScaleTransform x:Name="Zoom" />
                </Grid.LayoutTransform>
                <Image x:Name="BaseImage" Stretch="None" RenderOptions.BitmapScalingMode="HighQuality" />
                <Canvas x:Name="Shapes" IsHitTestVisible="False" />
                <InkCanvas x:Name="Ink" Background="Transparent" Cursor="Pen" />
                <Canvas x:Name="Draft" Background="Transparent" Cursor="Cross" Visibility="Collapsed"
                        MouseLeftButtonDown="Draft_Down" MouseMove="Draft_Move" MouseLeftButtonUp="Draft_Up" />
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
