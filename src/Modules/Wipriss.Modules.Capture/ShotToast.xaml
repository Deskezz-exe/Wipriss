<Window x:Class="Wipriss.Modules.Capture.ShotToast"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wipriss · Скриншот"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False" SizeToContent="WidthAndHeight"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}" Opacity="0">
    <Border x:Name="Card" Margin="8" Background="{StaticResource IslandBrush}" BorderBrush="#34322D" BorderThickness="1"
            CornerRadius="14" Padding="10" Cursor="Hand" MouseLeftButtonUp="Card_Click">
        <Border.RenderTransform>
            <TranslateTransform x:Name="Slide" Y="10" />
        </Border.RenderTransform>
        <StackPanel Width="264">
            <Grid>
                <Border CornerRadius="8" ClipToBounds="True" Background="#151412" MaxHeight="150">
                    <Image x:Name="Thumb" Stretch="Uniform" MaxHeight="150" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0" Style="{StaticResource IconButton}"
                        Background="#CC0B0B0A" Content="&#xE711;" ToolTip="Закрыть" Click="Close_Click" />
            </Grid>
            <TextBlock x:Name="TitleText" Margin="4,10,4,0" FontWeight="SemiBold" Text="Скриншот в буфере" />
            <TextBlock x:Name="HintText" Margin="4,2,4,2" Style="{StaticResource Caption}"
                       Text="Ctrl+V, чтобы вставить. Нажмите, чтобы порисовать или сохранить." />
        </StackPanel>
    </Border>
</Window>
