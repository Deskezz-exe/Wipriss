<Window x:Class="Wipriss.Modules.Capture.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wipriss · Скриншот"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" WindowStartupLocation="Manual"
        Background="Black" Cursor="Cross" FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <!-- One choice on the capture bar: icon plus word -->
        <Style x:Key="ChoiceBase" TargetType="ButtonBase">
            <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Bd" CornerRadius="9" Padding="12,7" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="{StaticResource IconFont}"
                                           FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                <Setter TargetName="Bd" Property="Background" Value="#1A1A1D" />
                            </Trigger>
                            <Trigger Property="ToggleButton.IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SocketFillBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Choice" TargetType="RadioButton" BasedOn="{StaticResource ChoiceBase}" />
        <Style x:Key="Action" TargetType="Button" BasedOn="{StaticResource ChoiceBase}" />
    </Window.Resources>

    <Grid x:Name="Root">
        <Image x:Name="Shot" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
        <Path x:Name="Dim" Fill="#99070706" IsHitTestVisible="False" />
        <Rectangle x:Name="Frame" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" IsHitTestVisible="False"
                   Stroke="#E6E6E9" StrokeThickness="1.5" />
        <Border x:Name="SizeTag" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" IsHitTestVisible="False"
                Background="#E60B0B0A" CornerRadius="6" Padding="7,2">
            <TextBlock x:Name="SizeText" FontFamily="{StaticResource SmallFont}" FontSize="11.5" Typography.NumeralAlignment="Tabular" />
        </Border>

        <StackPanel x:Name="Bar" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,24,0,0" Cursor="Arrow">
            <Border Background="{StaticResource IslandBrush}" BorderBrush="#3A3A40" BorderThickness="1" CornerRadius="14" Padding="5">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="AreaChoice" Style="{StaticResource Choice}" GroupName="CaptureMode" Tag="&#xE7A8;" Content="Область"
                                 IsChecked="True" Checked="Mode_Checked" ToolTip="Выделите область или щёлкните по окну" />
                    <Button Style="{StaticResource Action}" Tag="&#xE7F4;" Content="Весь экран" Click="Screen_Click"
                            ToolTip="Снять весь этот экран" />
                    <RadioButton x:Name="ScrollChoice" Style="{StaticResource Choice}" GroupName="CaptureMode" Tag="&#xEC8F;" Content="Со скроллом"
                                 Checked="Mode_Checked" ToolTip="Страница пролистается сама и склеится в одну картинку" />
                    <Border Width="1" Margin="6,6" Background="{StaticResource LineBrush}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" Click="Cancel_Click" ToolTip="Отмена (Esc)" />
                </StackPanel>
            </Border>
            <Border HorizontalAlignment="Center" Margin="0,8,0,0" Background="#E60B0B0A" CornerRadius="8" Padding="10,4">
                <TextBlock x:Name="HintText" FontFamily="{StaticResource SmallFont}" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" />
            </Border>
        </StackPanel>
    </Grid>
</Window>
