<UserControl x:Class="Wipriss.Modules.ClipboardHistory.ClipboardPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button x:Name="ClearButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE74D;"
                    ToolTip="Очистить всё" Click="Clear_Click" MouseLeave="Clear_MouseLeave" />
            <Button x:Name="PauseButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="Pause_Click" />
            <Border Style="{StaticResource SegmentTrack}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Segment}" GroupName="ClipFilter" Content="Все" Tag="all" IsChecked="True" Checked="Filter_Checked" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="ClipFilter" Content="Текст" Tag="text" Checked="Filter_Checked" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="ClipFilter" Content="Фото" Tag="image" Checked="Filter_Checked" />
                </StackPanel>
            </Border>
        </DockPanel>

        <TextBlock x:Name="Hint" DockPanel.Dock="Bottom" Margin="2,10,0,0" Style="{StaticResource Caption}"
                   Text="Клик по записи копирует её снова. Хранятся 20 последних, зашифрованы, только на этом компьютере. Пароли из менеджеров паролей не сохраняются." />

        <Grid>
            <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                       Foreground="{StaticResource SubtleTextBrush}" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="List">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ListCard}" Cursor="Hand" MouseLeftButtonUp="Item_Click"
                                    ToolTip="Нажмите, чтобы скопировать снова">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" VerticalAlignment="Top" Style="{StaticResource IconButton}"
                                            Content="&#xE711;" ToolTip="Убрать из истории" Click="Delete_Click" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" MaxHeight="58"
                                                   TextTrimming="CharacterEllipsis" Visibility="{Binding TextVisibility}" />
                                        <Image Source="{Binding Thumb}" MaxHeight="130" HorizontalAlignment="Left" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality" Visibility="{Binding ImageVisibility}" />
                                        <TextBlock Text="{Binding Meta}" Margin="0,5,0,0" FontSize="11"
                                                   Foreground="{StaticResource SubtleTextBrush}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
