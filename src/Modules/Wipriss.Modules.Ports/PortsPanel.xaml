<UserControl x:Class="Wipriss.Modules.Ports.PortsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Border DockPanel.Dock="Right" Style="{StaticResource SegmentTrack}" Margin="8,0,0,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Segment}" GroupName="PortProto" Content="TCP" Tag="tcp" IsChecked="True"
                                 Checked="Protocol_Checked" ToolTip="Порты, которые ждут подключений (серверы)" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="PortProto" Content="UDP" Tag="udp"
                                 Checked="Protocol_Checked" />
                </StackPanel>
            </Border>
            <TextBox x:Name="SearchBox" Style="{StaticResource InputBox}" Tag="Порт или программа" TextChanged="Search_Changed" />
        </DockPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="2,10,0,0">
            <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" Margin="0,0,0,6" Visibility="Collapsed" />
            <TextBlock x:Name="HintText" Style="{StaticResource Caption}" Foreground="{StaticResource FaintTextBrush}"
                       Text="Части Windows, службы, Docker и WSL помечены, отсюда их не останавливаем." />
        </StackPanel>

        <Grid>
            <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                       Foreground="{StaticResource SubtleTextBrush}" Visibility="Collapsed" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="List" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Card" Style="{StaticResource ListCard}" Padding="12,8,6,8" Margin="0,0,0,4">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding PortText}" FontFamily="{StaticResource DisplayFont}" FontSize="17"
                                                   FontWeight="SemiBold" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                                        <StackPanel Grid.Column="1" Margin="4,0,8,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" ToolTip="{Binding FullCommand}">
                                                <Grid Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="NoIcon" Text="&#xE770;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                               Foreground="{StaticResource FaintTextBrush}" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" Visibility="Collapsed" />
                                                    <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" />
                                                </Grid>
                                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" MaxWidth="270" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Details}" Margin="0,2,0,0" FontFamily="{StaticResource SmallFont}"
                                                       FontSize="11" Foreground="{StaticResource SubtleTextBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Остановить"
                                                Visibility="{Binding StopVisibility}" Click="Stop_Click" VerticalAlignment="Center" />
                                        <Border Grid.Column="2" Visibility="{Binding TagVisibility}" VerticalAlignment="Center" Margin="0,0,6,0"
                                                CornerRadius="6" Padding="7,2" BorderThickness="1" BorderBrush="{StaticResource LineBrush}"
                                                ToolTip="{Binding WhyNot}">
                                            <TextBlock Text="{Binding Tag}" FontFamily="{StaticResource SmallFont}" FontSize="11"
                                                       Foreground="{StaticResource SubtleTextBrush}" />
                                        </Border>
                                    </Grid>

                                    <!-- Confirmation: nothing is stopped without it -->
                                    <StackPanel x:Name="Confirm" Margin="68,8,4,4" Visibility="Collapsed">
                                        <TextBlock Text="{Binding ConfirmText}" TextWrapping="Wrap" FontSize="12.5" />
                                        <WrapPanel Margin="0,8,0,0">
                                            <Button Style="{StaticResource DangerButton}" Content="{Binding PrimaryText}" FontSize="12"
                                                    Click="Primary_Click" Margin="0,0,6,6" />
                                            <Button Style="{StaticResource PlainButton}" Content="{Binding LauncherText}" FontSize="12"
                                                    Visibility="{Binding LauncherVisibility}" Click="Launcher_Click" Margin="0,0,6,6"
                                                    ToolTip="Остановить и программу, которая запустила сервер, иначе она может запустить его снова" />
                                            <Button Style="{StaticResource PlainButton}" Content="Отмена" FontSize="12" Click="Cancel_Click"
                                                    Margin="0,0,0,6" />
                                        </WrapPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                    <Setter TargetName="NoIcon" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsAsking}" Value="True">
                                    <Setter TargetName="Confirm" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
