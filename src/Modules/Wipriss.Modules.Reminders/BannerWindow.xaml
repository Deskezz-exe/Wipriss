<Window x:Class="Wipriss.Modules.Reminders.BannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wipriss · Напоминание"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        Width="380" SizeToContent="Height" UseLayoutRounding="True"
        Background="{StaticResource IslandBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
    <DockPanel Margin="16,15,18,16">
        <ContentControl DockPanel.Dock="Left" Style="{StaticResource Socket}" Content="&#xEA8F;"
                        Margin="0,1,13,0" VerticalAlignment="Top" />
        <StackPanel>
            <TextBlock x:Name="Caption" Style="{StaticResource Caption}" />
            <TextBlock x:Name="TitleText" Margin="0,1,0,0" Style="{StaticResource PanelTitle}" FontSize="16" TextWrapping="Wrap" />
            <TextBlock x:Name="WhenText" Margin="0,2,0,0" Foreground="{StaticResource SubtleTextBrush}" />
            <StackPanel Orientation="Horizontal" Margin="0,13,0,0">
                <Button Style="{StaticResource PrimaryButton}" Content="Готово" Click="Done_Click" />
                <Button x:Name="SnoozeButton" Style="{StaticResource PlainButton}" Content="Через 10 мин" Margin="8,0,0,0"
                        Click="Snooze_Click" />
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
