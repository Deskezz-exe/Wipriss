<UserControl x:Class="Wipriss.Modules.Tables.TablesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" DragOver="Panel_DragOver" Drop="Panel_Drop">
    <StackPanel>
        <Border Style="{StaticResource Card}" Padding="14,12">
            <StackPanel>
                <TextBlock Text="Таблицы в тёмном окне" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,10" TextWrapping="Wrap"
                           Text="Поиск, сортировка, закреплённая шапка, весь экран. XLSX, XLS, XLSB, ODS, CSV, TSV. Можно перетащить файл на островок." />
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource PrimaryButton}" Content="Открыть таблицу…" Click="Pick_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,10,0,0">
            <StackPanel>
                <CheckBox x:Name="MenuToggle" Style="{StaticResource ToggleSwitch}"
                          Content="«Открыть в Wipriss» в меню Проводника"
                          Checked="Menu_Changed" Unchecked="Menu_Changed" />
                <TextBlock x:Name="MenuHint" Style="{StaticResource Caption}" Margin="0,5,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <TextBlock x:Name="Status" Style="{StaticResource Caption}" Margin="2,10,0,0" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
