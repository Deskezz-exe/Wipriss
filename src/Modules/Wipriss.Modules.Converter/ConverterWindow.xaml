<Window x:Class="Wipriss.Modules.Converter.ConverterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Wipriss.Modules.Converter"
        Title="Wipriss · Изменить фото"
        WindowStartupLocation="CenterScreen" Width="1180" Height="760" MinWidth="900" MinHeight="560"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
    <Window.Resources>
        <!-- A round badge in the corner of a tile -->
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="Height" Value="22" />
            <Setter Property="MinWidth" Value="22" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Background" Value="#CC141312" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <!-- ===== The pictures ===== -->
        <DockPanel Grid.Column="0" Margin="16,12,8,16">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <Button DockPanel.Dock="Right" Style="{StaticResource PlainButton}" Content="+ Добавить фото" Click="Add_Click"
                        ToolTip="Или перетащите картинки в это окно" />
                <Button x:Name="ClearButton" DockPanel.Dock="Right" Style="{StaticResource PlainButton}" Content="Убрать все"
                        Margin="0,0,8,0" Click="Clear_Click" />
                <TextBlock x:Name="CountText" VerticalAlignment="Center" Style="{StaticResource SectionTitle}" />
            </DockPanel>

            <Grid>
                <Border x:Name="EmptyBox" CornerRadius="12" BorderThickness="1.5" BorderBrush="{StaticResource LineStrongBrush}"
                        Background="{StaticResource SunkenBrush}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Перетащите сюда картинки" HorizontalAlignment="Center" FontSize="16" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,12" HorizontalAlignment="Center"
                                   Text="JPG, PNG, WEBP, AVIF, HEIC, BMP, ICO, TIFF, GIF" />
                        <Button Style="{StaticResource PlainButton}" Content="Выбрать файлы…" HorizontalAlignment="Center" Click="Add_Click" />
                    </StackPanel>
                </Border>

                <ScrollViewer x:Name="Viewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="Tiles">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <local:PreviewGrid Loaded="Grid_Loaded" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Frame" CornerRadius="10" BorderThickness="2" BorderBrush="Transparent"
                                        Background="{StaticResource CardBrush}" Cursor="Hand" Padding="4"
                                        MouseLeftButtonDown="Tile_MouseDown">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="28" />
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0" CornerRadius="7" Background="{StaticResource SunkenBrush}" ClipToBounds="True">
                                            <Grid>
                                                <Image Source="{Binding Thumb}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                                <TextBlock x:Name="Loading" Text="загружаю…" Style="{StaticResource Caption}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>

                                        <!-- Badges: drawn on, own settings, done, failed -->
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6">
                                            <Border x:Name="EditedBadge" Style="{StaticResource Badge}" Visibility="Collapsed" ToolTip="С рисунком">
                                                <TextBlock Text="&#xE70F;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" />
                                            </Border>
                                            <Border x:Name="OwnBadge" Style="{StaticResource Badge}" Visibility="Collapsed" ToolTip="Свои настройки">
                                                <TextBlock Text="{Binding OwnText}" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                                            </Border>
                                            <Border x:Name="DoneBadge" Style="{StaticResource Badge}" Visibility="Collapsed" ToolTip="{Binding Result}">
                                                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center"
                                                           Foreground="{StaticResource OkBrush}" />
                                            </Border>
                                            <Border x:Name="FailedBadge" Style="{StaticResource Badge}" Visibility="Collapsed" ToolTip="{Binding Result}">
                                                <TextBlock Text="&#xE783;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center"
                                                           Foreground="{StaticResource DangerBrush}" />
                                            </Border>
                                        </StackPanel>

                                        <!-- Remove from the list -->
                                        <Button x:Name="RemoveButton" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
                                                Width="26" Height="26" Click="Remove_Click" ToolTip="Убрать из списка" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Back" CornerRadius="13" Background="#CC141312">
                                                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Back" Property="Background" Value="{StaticResource DangerBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <!-- Progress while converting: only its scale changes -->
                                        <Border x:Name="Bar" Grid.Row="0" Height="4" VerticalAlignment="Bottom" Margin="8,0,8,8" CornerRadius="2"
                                                Background="#99141312" Visibility="Collapsed">
                                            <Border CornerRadius="2" Background="{StaticResource AccentBrush}" RenderTransformOrigin="0,0">
                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleX="{Binding ProgressFraction}" />
                                                </Border.RenderTransform>
                                            </Border>
                                        </Border>

                                        <DockPanel Grid.Row="1" Margin="4,4,4,0">
                                            <TextBlock x:Name="Right" DockPanel.Dock="Right" Text="{Binding SourceSize}" Margin="6,0,0,0"
                                                       Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12" ToolTip="{Binding Path}" />
                                        </DockPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding HasThumb}" Value="True">
                                        <Setter TargetName="Loading" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding NoPreview}" Value="True">
                                        <Setter TargetName="Loading" Property="Text" Value="без превью" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsEdited}" Value="True">
                                        <Setter TargetName="EditedBadge" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasOwn}" Value="True">
                                        <Setter TargetName="OwnBadge" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                        <Setter TargetName="DoneBadge" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                        <Setter TargetName="FailedBadge" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsWorking}" Value="True">
                                        <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="RemoveButton" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="Right" Property="Text" Value="{Binding ProgressText}" />
                                        <Setter TargetName="Right" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </DockPanel>

        <!-- ===== Settings ===== -->
        <Border Grid.Column="1" Background="{StaticResource SunkenBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1,0,0,0">
            <DockPanel Margin="16,14,16,16">
                <!-- Run -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <TextBlock x:Name="Status" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="2,0,0,8" />
                    <Button x:Name="RunButton" Style="{StaticResource PrimaryButton}" Content="Применить" Click="Run_Click"
                            HorizontalAlignment="Stretch" Padding="12,9" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- Replace originals: in plain sight, off by default -->
                        <Border Style="{StaticResource Card}" Padding="12,10">
                            <StackPanel>
                                <CheckBox x:Name="ReplaceToggle" Style="{StaticResource ToggleSwitch}" Content="Заменить оригиналы"
                                          Checked="Replace_Changed" Unchecked="Replace_Changed" />
                                <TextBlock x:Name="ReplaceHint" Style="{StaticResource Caption}" Margin="0,5,0,0" TextWrapping="Wrap"
                                           Text="Выключено: результат сохранится рядом под новым именем, оригинал не меняется." />
                            </StackPanel>
                        </Border>

                        <!-- Whose settings -->
                        <StackPanel x:Name="ScopeBox" Margin="0,14,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="SelectedName" Style="{StaticResource SectionTitle}" TextTrimming="CharacterEllipsis" Margin="2,0,0,6" />
                            <Border Style="{StaticResource SegmentTrack}" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="ScopeAll" Style="{StaticResource Segment}" GroupName="Scope" Content="Как у всех" Checked="Scope_Checked" />
                                    <RadioButton x:Name="ScopeOwn" Style="{StaticResource Segment}" GroupName="Scope" Content="Свои настройки" Checked="Scope_Checked" />
                                </StackPanel>
                            </Border>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Style="{StaticResource PlainButton}" Content="Рисовать на фото…" Click="Draw_Click" Margin="0,0,6,6"
                                        ToolTip="Кисть, маркер, стрелка, рамка, размытие, обрезка (двойной щелчок по фото)" />
                                <Button x:Name="UndrawButton" Style="{StaticResource PlainButton}" Content="Убрать рисунок" Click="Undraw_Click"
                                        Margin="0,0,6,6" Visibility="Collapsed" />
                                <Button x:Name="RevealButton" Style="{StaticResource PlainButton}" Content="Показать в папке" Click="Reveal_Click"
                                        Margin="0,0,6,6" Visibility="Collapsed" />
                            </WrapPanel>
                            <TextBlock x:Name="SelectedResult" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="2,0,0,0" />
                        </StackPanel>

                        <TextBlock x:Name="SettingsTitle" Style="{StaticResource SectionTitle}" Text="Для всех фото" Margin="2,16,0,0" />

                        <TextBlock Style="{StaticResource Caption}" Text="Формат" Margin="2,10,0,6" />
                        <Border Style="{StaticResource SegmentTrack}" HorizontalAlignment="Left">
                            <WrapPanel x:Name="FormatGroup">
                                <RadioButton Style="{StaticResource Segment}" GroupName="Format" Content="JPG" Tag="Jpg" Checked="Format_Checked" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="Format" Content="PNG" Tag="Png" Checked="Format_Checked" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="Format" Content="WEBP" Tag="WebP" Checked="Format_Checked" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="Format" Content="AVIF" Tag="Avif" Checked="Format_Checked" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="Format" Content="BMP" Tag="Bmp" Checked="Format_Checked" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="Format" Content="ICO" Tag="Ico" Checked="Format_Checked" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="Format" Content="TIFF" Tag="Tiff" Checked="Format_Checked" />
                            </WrapPanel>
                        </Border>

                        <CheckBox x:Name="BackgroundToggle" Style="{StaticResource ToggleSwitch}" Margin="0,14,0,0"
                                  Content="Убрать фон"
                                  ToolTip="Однотонный фон (белая бумага, ровный цвет, студийный фон) станет прозрачным. Нужен PNG, WEBP, AVIF, ICO или TIFF."
                                  Checked="Background_Changed" Unchecked="Background_Changed" />

                        <CheckBox x:Name="LimitToggle" Style="{StaticResource ToggleSwitch}" Margin="0,12,0,0"
                                  Content="Сжать" Checked="Limit_Changed" Unchecked="Limit_Changed"
                                  ToolTip="Качество, а если нужно и размер, понизятся ровно настолько, чтобы файл влез в этот вес" />
                        <StackPanel x:Name="LimitRow" Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Не больше" VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" Margin="2,0,8,0" />
                            <TextBox x:Name="LimitBox" Style="{StaticResource InputBox}" Width="56"
                                     TextChanged="Number_TextChanged" PreviewTextInput="Decimal_PreviewTextInput" />
                            <TextBlock Text="МБ на файл" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource Caption}" Text="Размер" Margin="2,14,0,6" />
                        <Border Style="{StaticResource SegmentTrack}" HorizontalAlignment="Left">
                            <StackPanel x:Name="ResizeGroup" Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" GroupName="Resize" Content="Как есть" Tag="None" Checked="Resize_Checked" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="Resize" Content="Пиксели" Tag="Pixels" Checked="Resize_Checked" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="Resize" Content="Проценты" Tag="Percent" Checked="Resize_Checked" />
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="PixelsBox" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                            <TextBox x:Name="WidthBox" Style="{StaticResource InputBox}" Width="70" Tag="ширина"
                                     TextChanged="Number_TextChanged" PreviewTextInput="Digits_PreviewTextInput" />
                            <TextBlock Text="×" Margin="6,0" VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" />
                            <TextBox x:Name="HeightBox" Style="{StaticResource InputBox}" Width="70" Tag="высота"
                                     TextChanged="Number_TextChanged" PreviewTextInput="Digits_PreviewTextInput" />
                        </StackPanel>
                        <StackPanel x:Name="PercentBox" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                            <TextBox x:Name="PercentInput" Style="{StaticResource InputBox}" Width="56"
                                     TextChanged="Number_TextChanged" PreviewTextInput="Digits_PreviewTextInput" />
                            <TextBlock Text="%" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="ResizeHint" Style="{StaticResource Caption}" Margin="2,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"
                                   Text="Картинка впишется в этот размер, пропорции сохранятся. Одну сторону можно не заполнять." />

                        <TextBlock Style="{StaticResource Caption}" Margin="2,16,0,0" TextWrapping="Wrap"
                                   Text="Данные камеры и место съёмки в новые файлы не переносятся." />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
