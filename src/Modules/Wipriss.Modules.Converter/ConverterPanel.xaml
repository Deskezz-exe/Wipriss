<UserControl x:Class="Wipriss.Modules.Converter.ConverterPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" DragOver="Panel_DragOver" Drop="Panel_Drop">
    <StackPanel>
        <Border Style="{StaticResource Card}" Padding="14,12">
            <StackPanel>
                <TextBlock Text="Перетащите картинки на островок или сюда" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,10" TextWrapping="Wrap"
                           Text="Откроется окно правки: формат, сжатие, размер, фон, рисование. JPG, PNG, WEBP, AVIF, HEIC, BMP, ICO, TIFF, GIF." />
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource PrimaryButton}" Content="Выбрать картинки…" Click="Pick_Click" />
                    <Button x:Name="OpenButton" Style="{StaticResource PlainButton}" Content="Открыть окно правки" Margin="8,0,0,0"
                            Click="Open_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,10,0,0">
            <StackPanel>
                <CheckBox x:Name="MenuToggle" Style="{StaticResource ToggleSwitch}"
                          Content="«Изменить через Wipriss» в меню Проводника"
                          Checked="Menu_Changed" Unchecked="Menu_Changed" />
                <TextBlock x:Name="MenuHint" Style="{StaticResource Caption}" Margin="0,5,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <TextBlock x:Name="Status" Style="{StaticResource Caption}" Margin="2,10,0,0" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
