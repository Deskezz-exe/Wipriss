<Window x:Class="Wipriss.Modules.Cleaner.CleanerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Wipriss.Modules.Cleaner"
        Title="Wipriss · Очистка"
        WindowStartupLocation="CenterScreen" Width="1060" Height="760" MinWidth="820" MinHeight="560"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True">
    <Window.Resources>
        <!-- A small square tick box (the theme has only the toggle switch) -->
        <Style x:Key="Tick" TargetType="CheckBox">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Box" Width="16" Height="16" CornerRadius="4" BorderThickness="1.2"
                                BorderBrush="{StaticResource LineStrongBrush}" Background="Transparent">
                            <TextBlock x:Name="Mark" FontFamily="{StaticResource IconFont}" FontSize="10" Text="&#xE73E;"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource WindowBrush}"
                                       Visibility="Collapsed" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="{x:Null}">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Mark" Property="Text" Value="&#xE738;" />
                                <Setter TargetName="Mark" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Box" Property="Opacity" Value="0.3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowButton" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource TileHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- A section in the left column -->
        <Style x:Key="SectionButton" TargetType="RadioButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Back" CornerRadius="10" Padding="12,10" Margin="0,0,0,4" Background="Transparent"
                                BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{StaticResource TileHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{StaticResource AccentFillBrush}" />
                                <Setter TargetName="Back" Property="BorderBrush" Value="{StaticResource AccentLineBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sub-heading inside a section: «Windows    9,6 ГБ» -->
        <DataTemplate DataType="{x:Type local:CategoryRow}">
            <Border Style="{StaticResource RowButton}" Margin="0,12,0,4" Padding="4,5,8,5" MouseLeftButtonUp="Category_Click">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Chevron}" FontFamily="{StaticResource IconFont}" FontSize="9"
                               Foreground="{StaticResource FaintTextBrush}" VerticalAlignment="Center" Width="16" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" Foreground="{StaticResource SubtleTextBrush}"
                               FontSize="12" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                    <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- Program: tick, name, status, colour dots, size -->
        <DataTemplate DataType="{x:Type local:GroupRow}">
            <Border Style="{StaticResource ListCard}" Margin="0,0,0,4" Padding="8,8,12,8" Cursor="Hand" MouseLeftButtonUp="Group_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Chevron}" FontFamily="{StaticResource IconFont}" FontSize="9"
                               Foreground="{StaticResource FaintTextBrush}" VerticalAlignment="Center" />
                    <CheckBox Grid.Column="1" Style="{StaticResource Tick}" IsChecked="{Binding IsChecked, Mode=OneWay}"
                              IsEnabled="{Binding CanSelect}" Click="GroupTick_Click" VerticalAlignment="Center" HorizontalAlignment="Left" />
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                        <TextBlock Text="{Binding Status}" FontFamily="{StaticResource SmallFont}" FontSize="11" Margin="0,1,0,0"
                                   Foreground="{StaticResource SubtleTextBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                        <Ellipse Width="7" Height="7" Margin="3,0" Fill="{StaticResource OkBrush}" Visibility="{Binding HasGreen}" />
                        <Ellipse Width="7" Height="7" Margin="3,0" Fill="{StaticResource WarnBrush}" Visibility="{Binding HasYellow}" />
                        <Ellipse Width="7" Height="7" Margin="3,0" Fill="{StaticResource DangerBrush}" Visibility="{Binding HasRed}" />
                    </StackPanel>
                    <TextBlock Grid.Column="4" Text="{Binding SizeText}" VerticalAlignment="Center" FontSize="12.5" MinWidth="64"
                               TextAlignment="Right" Typography.NumeralAlignment="Tabular" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- One kind of data of a program: «Кэш», «Пароли» -->
        <DataTemplate DataType="{x:Type local:ItemRow}">
            <Border Style="{StaticResource RowButton}" Margin="22,0,0,2" Padding="8,6,12,6" MouseLeftButtonUp="Item_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Style="{StaticResource Tick}" IsChecked="{Binding IsChecked}" Visibility="{Binding BoxVisibility}"
                              VerticalAlignment="Center" HorizontalAlignment="Left" />
                    <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{Binding TextBrush}"
                               Visibility="{Binding LockVisibility}" VerticalAlignment="Center" Margin="1,0,0,0"
                               ToolTip="Выбрать нельзя. Нажмите, чтобы узнать почему" />
                    <Ellipse Grid.Column="1" Width="8" Height="8" Fill="{Binding Brush}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                    <TextBlock Grid.Column="2" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                    <TextBlock Grid.Column="3" Text="{Binding ColorText}" Foreground="{Binding TextBrush}" FontFamily="{StaticResource SmallFont}"
                               FontSize="11" VerticalAlignment="Center" Margin="8,0,14,0" />
                    <TextBlock Grid.Column="4" Text="{Binding SizeText}" VerticalAlignment="Center" FontSize="12" MinWidth="64" TextAlignment="Right"
                               Foreground="{StaticResource SubtleTextBrush}" Typography.NumeralAlignment="Tabular" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- The card: what, if deleted, how Windows cleans it, why we think so, where -->
        <DataTemplate DataType="{x:Type local:DetailRow}">
            <Border Style="{StaticResource Card}" Margin="48,0,0,8" Padding="14,10,12,12" BorderBrush="{StaticResource LineBrush}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Ellipse Width="7" Height="7" Fill="{Binding Brush}" VerticalAlignment="Center" Margin="0,1,7,0" />
                        <TextBlock Text="{Binding ColorText}" Foreground="{Binding Brush}" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Text="{Binding What}" TextWrapping="Wrap" LineHeight="19" />
                    <TextBlock Text="{Binding IfDeleted}" TextWrapping="Wrap" LineHeight="19" Margin="0,6,0,0" Foreground="{StaticResource SubtleTextBrush}" />
                    <Border Margin="0,8,0,0" Padding="10,7" CornerRadius="8" Background="{StaticResource SunkenBrush}" Visibility="{Binding HowToVisibility}">
                        <TextBlock Text="{Binding HowToClean}" TextWrapping="Wrap" FontSize="12" LineHeight="18" />
                    </Border>
                    <ItemsControl ItemsSource="{Binding Evidence}" Margin="0,8,0,0" Focusable="False" Visibility="{Binding EvidenceVisibility}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,3">
                                    <Ellipse Width="4" Height="4" Margin="1,7,9,0" VerticalAlignment="Top" Fill="{StaticResource FaintTextBrush}" />
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" LineHeight="18" Foreground="{StaticResource SubtleTextBrush}" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Facts}" Margin="0,6,0,0" FontFamily="{StaticResource SmallFont}" FontSize="11"
                               Foreground="{StaticResource FaintTextBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding PathsText}" Margin="0,4,0,0" FontFamily="{StaticResource SmallFont}" FontSize="11"
                               Foreground="{StaticResource FaintTextBrush}" TextWrapping="Wrap" Visibility="{Binding PathsVisibility}" />
                    <WrapPanel Margin="0,10,0,0">
                        <Button Style="{StaticResource PlainButton}" FontSize="12" Content="Показать в папке" Click="Folder_Click" Margin="0,0,6,0"
                                Visibility="{Binding PathsVisibility}" />
                        <Button Style="{StaticResource PlainButton}" FontSize="12" Content="Больше не показывать" Click="Hide_Click"
                                Visibility="{Binding HideVisibility}" ToolTip="Этот пункт пропадёт из списка и в следующих поисках" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
        <!-- ===== Installed programs ===== -->
        <DataTemplate DataType="{x:Type local:ProgramRow}">
            <Border Style="{StaticResource ListCard}" Margin="0,0,0,4" Padding="10,8,10,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="28" Height="28" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Border CornerRadius="6" Background="{StaticResource SunkenBrush}" Visibility="{Binding PlaceholderVisibility}">
                            <TextBlock Text="&#xE71D;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{StaticResource FaintTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Image Source="{Binding Icon}" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                        <TextBlock Text="{Binding Details}" FontFamily="{StaticResource SmallFont}" FontSize="11" Margin="0,2,0,0"
                                   Foreground="{StaticResource SubtleTextBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Details}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" VerticalAlignment="Center" FontSize="12.5" MinWidth="64" Margin="0,0,14,0"
                               TextAlignment="Right" Typography.NumeralAlignment="Tabular" Foreground="{StaticResource SubtleTextBrush}" />
                    <Button Grid.Column="3" Style="{StaticResource PlainButton}" FontSize="12" Content="Удалить" Click="Uninstall_Click" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:TailHeaderRow}">
            <DockPanel Margin="4,12,8,6">
                <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" Foreground="{StaticResource SubtleTextBrush}" FontSize="12"
                           Typography.NumeralAlignment="Tabular" />
                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" />
            </DockPanel>
        </DataTemplate>

        <!-- A tail: chevron (a folder with contents), tick, colour, what and why, size -->
        <DataTemplate DataType="{x:Type local:TailRow}">
            <Border Style="{StaticResource RowButton}" Margin="{Binding Indent}" Padding="6,6,12,6" MouseLeftButtonUp="Tail_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Chevron}" FontFamily="{StaticResource IconFont}" FontSize="9" Visibility="{Binding ChevronVisibility}"
                               Foreground="{StaticResource FaintTextBrush}" VerticalAlignment="Center" />
                    <CheckBox Grid.Column="1" Style="{StaticResource Tick}" IsChecked="{Binding IsChecked, Mode=OneWay}" Click="TailTick_Click"
                              VerticalAlignment="Center" HorizontalAlignment="Left" />
                    <Ellipse Grid.Column="2" Width="8" Height="8" Fill="{Binding Brush}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                    <TextBlock Grid.Column="3" Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center"
                               Foreground="{StaticResource SubtleTextBrush}" />
                    <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                        <TextBlock Text="{Binding Evidence}" FontFamily="{StaticResource SmallFont}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource SubtleTextBrush}" />
                    </StackPanel>
                    <TextBlock Grid.Column="5" Text="{Binding SizeText}" VerticalAlignment="Center" FontSize="12" MinWidth="64" TextAlignment="Right"
                               Foreground="{StaticResource SubtleTextBrush}" Typography.NumeralAlignment="Tabular" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Left: sections ===== -->
        <Border x:Name="Sidebar" Background="{StaticResource TileBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,18,14,16">
                <StackPanel DockPanel.Dock="Top" Margin="6,0,0,16">
                    <TextBlock Text="Очистка" Style="{StaticResource PanelTitle}" />
                    <TextBlock x:Name="FoundText" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="6,12,0,0">
                    <!-- Every fixed drive: used, what the selection would free (green), free -->
                    <ItemsControl x:Name="DiskList" Focusable="False" Margin="-6,0,0,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="12,10,12,11" Margin="0,0,0,6">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding TotalText}" Style="{StaticResource Caption}" />
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        </DockPanel>
                                        <Border Height="8" CornerRadius="4" Margin="0,8,0,0" Background="{StaticResource SunkenBrush}" ClipToBounds="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding UsedStar}" />
                                                    <ColumnDefinition Width="{Binding SelectedStar}" />
                                                    <ColumnDefinition Width="{Binding FreeStar}" />
                                                </Grid.ColumnDefinitions>
                                                <Border CornerRadius="4,0,0,4" Background="{StaticResource SubtleTextBrush}" />
                                                <Border Grid.Column="1" Background="{StaticResource OkBrush}" />
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{Binding UsedText}" Style="{StaticResource Caption}" Margin="0,7,0,0" />
                                        <TextBlock Text="{Binding AfterText}" Style="{StaticResource Caption}" Foreground="{StaticResource OkBrush}" Margin="0,2,0,0"
                                                   TextWrapping="Wrap" Visibility="{Binding AfterVisibility}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DockPanel Margin="0,0,0,6">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource OkBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="можно удалить" Style="{StaticResource Caption}" />
                    </DockPanel>
                    <DockPanel Margin="0,0,0,6">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource WarnBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="возможно, важно" Style="{StaticResource Caption}" />
                    </DockPanel>
                    <DockPanel Margin="0,0,0,14">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource DangerBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="не удаляйте" Style="{StaticResource Caption}" />
                    </DockPanel>
                    <Button Style="{StaticResource PlainButton}" FontSize="12" Content="Искать снова" HorizontalAlignment="Left" Click="Scan_Click" />
                    <Button x:Name="UnhideButton" Style="{StaticResource PlainButton}" FontSize="11.5" HorizontalAlignment="Left"
                            Click="Unhide_Click" Visibility="Collapsed" Margin="0,8,0,0" />
                </StackPanel>

                <StackPanel>
                    <ItemsControl x:Name="SectionList" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource SectionButton}" GroupName="Sections" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                         Checked="Section_Checked">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center"
                                               Foreground="{StaticResource SubtleTextBrush}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding GreenText}" FontFamily="{StaticResource SmallFont}" FontSize="11"
                                                   Foreground="{StaticResource SubtleTextBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="12" VerticalAlignment="Top" Margin="6,2,0,0"
                                               Foreground="{StaticResource SubtleTextBrush}" Typography.NumeralAlignment="Tabular" />
                                </Grid>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Height="1" Background="{StaticResource DividerBrush}" Margin="8,8,8,12" />
                    <RadioButton x:Name="ProgramsTab" Style="{StaticResource SectionButton}" GroupName="Sections" Checked="ProgramsTab_Checked">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE7B8;" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center"
                                       Foreground="{StaticResource SubtleTextBrush}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Установленные программы" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="удалить вместе с остатками" FontFamily="{StaticResource SmallFont}" FontSize="11"
                                           Foreground="{StaticResource SubtleTextBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Right: the list of a section ===== -->
        <DockPanel x:Name="ResultsBox" Grid.Column="1" Margin="22,18,20,16">
            <!-- After a deletion: how much was freed -->
            <Border x:Name="ResultBanner" DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,14" Padding="18,14"
                    Background="{StaticResource AccentFillBrush}" BorderBrush="{StaticResource AccentLineBrush}" Visibility="Collapsed">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource PlainButton}" Content="Понятно" VerticalAlignment="Center" Click="DismissResult_Click" />
                    <ContentControl DockPanel.Dock="Left" Style="{StaticResource Socket}" Content="&#xE73E;" Width="44" Height="44" FontSize="19"
                                    Foreground="{StaticResource OkBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="ResultTitle" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource OkBrush}" />
                        <TextBlock x:Name="ResultText" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" LineHeight="18" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <DockPanel DockPanel.Dock="Top" Margin="2,0,0,2">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource PlainButton}" FontSize="12" Content="Выбрать зелёные" Click="SelectGreen_Click" Margin="0,0,6,0"
                            ToolTip="Отметить всё, что можно удалить, во всех разделах" />
                    <Button Style="{StaticResource PlainButton}" FontSize="12" Content="Выбрать всё" Click="SelectAll_Click" Margin="0,0,6,0"
                            ToolTip="Отметить и «возможно, важное» во всех разделах (красное не выбирается никогда)" />
                    <Button x:Name="ClearButton" Style="{StaticResource PlainButton}" FontSize="12" Content="Снять выбор" Click="Clear_Click" />
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="SectionTitle" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="SectionHint" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                </StackPanel>
            </DockPanel>

            <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="16,12">
                <DockPanel>
                    <Button x:Name="DeleteButton" DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Content="Удалить выбранное…"
                            Click="Delete_Click" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="SelectedText" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock x:Name="SelectedHint" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>


            <Grid>
                <TextBlock x:Name="EmptyText" Text="В этом разделе ничего не нашлось" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource SubtleTextBrush}" Visibility="Collapsed" />
                <ListBox x:Name="List" Background="Transparent" BorderThickness="0" Padding="0" Focusable="False" Foreground="{StaticResource TextBrush}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </DockPanel>

        <!-- ===== Right: installed programs ===== -->
        <Grid x:Name="ProgramsBox" Grid.Column="1" Visibility="Collapsed">
            <!-- The list -->
            <DockPanel x:Name="ProgramListBox" Margin="22,18,20,16">
                <Border x:Name="ProgramBanner" DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,14" Padding="18,14"
                        Background="{StaticResource AccentFillBrush}" BorderBrush="{StaticResource AccentLineBrush}" Visibility="Collapsed">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="RestoreButton" Style="{StaticResource PlainButton}" Content="Вернуть записи реестра" Margin="0,0,8,0" Click="RestoreLast_Click" />
                            <Button Style="{StaticResource PlainButton}" Content="Понятно" Click="ProgramBanner_Click" />
                        </StackPanel>
                        <ContentControl DockPanel.Dock="Left" Style="{StaticResource Socket}" Content="&#xE73E;" Width="44" Height="44" FontSize="19"
                                        Foreground="{StaticResource OkBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ProgramBannerTitle" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource OkBrush}" TextWrapping="Wrap" />
                            <TextBlock x:Name="ProgramBannerText" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" LineHeight="18" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <DockPanel DockPanel.Dock="Top" Margin="2,0,0,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox x:Name="ProgramSearch" Style="{StaticResource InputBox}" Width="220" Tag="Найти программу" TextChanged="ProgramSearch_Changed" Margin="0,0,8,0" />
                        <Button x:Name="SortButton" Style="{StaticResource PlainButton}" FontSize="12" Content="По имени" Click="Sort_Click"
                                ToolTip="Сортировка: по имени, по размеру, по дате установки" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Установленные программы" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock x:Name="ProgramsHint" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                    </StackPanel>
                </DockPanel>

                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="16,12">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource PlainButton}" FontSize="12" Content="Вернуть из копии…" Click="Backups_Click" Margin="0,0,6,0"
                                    ToolTip="Записи реестра, удалённые вместе с остатками программ, можно вернуть" />
                            <Button Style="{StaticResource PlainButton}" FontSize="12" Content="Обновить список" Click="ReloadPrograms_Click" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="18" VerticalAlignment="Center" Margin="0,0,12,0"
                                   Text="Сначала работает деинсталлятор самой программы. Потом Wipriss покажет, что от неё осталось, и удалит только то, что вы отметите." />
                    </DockPanel>
                </Border>

                <Grid>
                    <TextBlock x:Name="ProgramsEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{StaticResource SubtleTextBrush}" Visibility="Collapsed" />
                    <ListBox x:Name="ProgramList" Background="Transparent" BorderThickness="0" Padding="0" Focusable="False" Foreground="{StaticResource TextBrush}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                             ItemContainerStyle="{Binding ItemContainerStyle, ElementName=List}" />
                </Grid>
            </DockPanel>

            <!-- What the removed program left -->
            <DockPanel x:Name="TailsBox" Margin="22,18,20,16" Visibility="Collapsed">
                <DockPanel DockPanel.Dock="Top" Margin="2,0,0,4">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource PlainButton}" FontSize="12" Content="Выбрать зелёные" Click="TailsGreen_Click" Margin="0,0,6,0" />
                        <Button Style="{StaticResource PlainButton}" FontSize="12" Content="Выбрать всё" Click="TailsAll_Click" Margin="0,0,6,0" />
                        <Button Style="{StaticResource PlainButton}" FontSize="12" Content="Снять выбор" Click="TailsNone_Click" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="TailsTitle" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="TailsHint" Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>

                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="16,12">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource PlainButton}" Content="Оставить как есть" Click="TailsSkip_Click" Margin="0,0,8,0" />
                            <Button x:Name="TailsDeleteButton" Style="{StaticResource DangerButton}" Content="Удалить выбранное…" Click="TailsDelete_Click" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TailsSelected" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock x:Name="TailsSelectedHint" Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid>
                    <TextBlock x:Name="TailsEmpty" Text="Ничего не осталось: программа удалилась чисто." HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource SubtleTextBrush}" Visibility="Collapsed" />
                    <ListBox x:Name="TailList" Background="Transparent" BorderThickness="0" Padding="0" Focusable="False" Foreground="{StaticResource TextBrush}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                             ItemContainerStyle="{Binding ItemContainerStyle, ElementName=List}" />
                </Grid>
            </DockPanel>

            <!-- A step of the removal: confirm, uninstaller running, not removed, searching, deleting, failed -->
            <Border x:Name="FlowBox" Background="{StaticResource WindowBrush}" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480" Margin="20,0">
                    <ContentControl x:Name="FlowIcon" Style="{StaticResource Socket}" Content="&#xE74D;" Width="52" Height="52" FontSize="22" HorizontalAlignment="Center" />
                    <TextBlock x:Name="FlowTitle" Style="{StaticResource PanelTitle}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,16,0,0" />
                    <TextBlock x:Name="FlowText" Style="{StaticResource Caption}" TextAlignment="Center" TextWrapping="Wrap" LineHeight="19" Margin="0,8,0,0" />
                    <TextBlock x:Name="FlowWarning" TextAlignment="Center" TextWrapping="Wrap" LineHeight="19" FontSize="12.5" Margin="0,10,0,0"
                               Foreground="{StaticResource WarnBrush}" Visibility="Collapsed" />
                    <Grid x:Name="FlowTrack" Margin="0,16,0,0" Width="360" Visibility="Collapsed">
                        <Border Height="6" CornerRadius="3" Background="{StaticResource SunkenBrush}" />
                        <Border x:Name="FlowFill" Height="6" CornerRadius="3" HorizontalAlignment="Left" Width="0" Background="{StaticResource AccentBrush}" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                        <Button x:Name="FlowSecond" Style="{StaticResource PlainButton}" Margin="0,0,8,0" Click="FlowSecond_Click" />
                        <Button x:Name="FlowFirst" Style="{StaticResource PrimaryButton}" Click="FlowFirst_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Registry copies to put back -->
            <Border x:Name="BackupsBox" Background="#B3000000" Visibility="Collapsed">
                <Border Style="{StaticResource Card}" Width="500" MaxHeight="520" Padding="22,20" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource LineStrongBrush}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Вернуть записи реестра" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" Margin="0,8,0,12" TextWrapping="Wrap" LineHeight="19"
                                   Text="Перед удалением остатков Wipriss копирует удаляемые записи реестра. Файлы так не вернуть: они удаляются мимо Корзины." />
                        <Button DockPanel.Dock="Bottom" Style="{StaticResource PlainButton}" Content="Закрыть" HorizontalAlignment="Right" Margin="0,14,0,0" Click="BackupsClose_Click" />
                        <Grid>
                            <TextBlock x:Name="BackupsEmpty" Text="Копий пока нет" Foreground="{StaticResource SubtleTextBrush}" Visibility="Collapsed" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="BackupList" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource ListCard}" Padding="12,8" Margin="0,0,0,4">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource PlainButton}" FontSize="12" Content="Вернуть" Click="BackupRestore_Click"
                                                            VerticalAlignment="Center" />
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Program}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding WhenText}" Style="{StaticResource Caption}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </Border>
            </Border>
        </Grid>

        <!-- ===== Before the first search ===== -->        <Border x:Name="IntroBox" Grid.Column="1" Background="{StaticResource WindowBrush}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480">
                <ContentControl Style="{StaticResource Socket}" Content="&#xE74D;" Width="52" Height="52" FontSize="22" HorizontalAlignment="Center" />
                <TextBlock Text="Что занимает место" Style="{StaticResource PanelTitle}" HorizontalAlignment="Center" Margin="0,16,0,0" />
                <TextBlock Style="{StaticResource Caption}" TextAlignment="Center" TextWrapping="Wrap" LineHeight="19" Margin="0,8,0,0"
                           Text="Сначала Wipriss посмотрит, что установлено и чем вы пользуетесь, потом найдёт кэши, временные файлы и остатки удалённых программ. У каждой находки цвет и объяснение простыми словами." />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource OkBrush}" Margin="0,0,6,0" />
                    <TextBlock Text="можно удалить" Style="{StaticResource Caption}" Margin="0,0,16,0" />
                    <Ellipse Width="8" Height="8" Fill="{StaticResource WarnBrush}" Margin="0,0,6,0" />
                    <TextBlock Text="возможно, важно" Style="{StaticResource Caption}" Margin="0,0,16,0" />
                    <Ellipse Width="8" Height="8" Fill="{StaticResource DangerBrush}" Margin="0,0,6,0" />
                    <TextBlock Text="не удаляйте" Style="{StaticResource Caption}" />
                </StackPanel>
                <Button Style="{StaticResource PrimaryButton}" Content="Найти мусор" HorizontalAlignment="Center" Margin="0,22,0,0" Click="Scan_Click" />
                <TextBlock x:Name="ErrorText" Style="{StaticResource Caption}" Foreground="{StaticResource DangerBrush}" TextAlignment="Center"
                           TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />
                <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource FaintTextBrush}" TextAlignment="Center" TextWrapping="Wrap"
                           Margin="0,16,0,0" Text="Поиск только читает. Удаляется лишь то, что вы выберете и подтвердите." />
            </StackPanel>
        </Border>

        <!-- ===== Searching or deleting ===== -->
        <Border x:Name="ProgressBox" Grid.Column="1" Background="{StaticResource WindowBrush}" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" Width="420">
                <TextBlock x:Name="ProgressText" HorizontalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" />
                <Grid x:Name="ProgressTrack" Margin="0,12,0,0">
                    <Border Height="6" CornerRadius="3" Background="{StaticResource SunkenBrush}" />
                    <Border x:Name="ProgressFill" Height="6" CornerRadius="3" HorizontalAlignment="Left" Width="0" Background="{StaticResource AccentBrush}" />
                </Grid>
                <Button x:Name="CancelButton" Style="{StaticResource PlainButton}" Content="Отмена" HorizontalAlignment="Center" Margin="0,16,0,0" Click="Cancel_Click" />
            </StackPanel>
        </Border>

        <!-- ===== «Select everything?» ===== -->
        <Border x:Name="SelectAllBox" Grid.ColumnSpan="2" Background="#B3000000" Visibility="Collapsed">
            <Border Style="{StaticResource Card}" Width="470" Padding="22,20" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource LineStrongBrush}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{StaticResource WarnBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Text="Будьте осторожны" FontSize="18" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock x:Name="SelectAllText" Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="20" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="19"
                               Text="Красные пункты (пароли, закладки, системное) не выбираются никогда. Перед удалением ещё раз покажем, сколько освободится." />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Style="{StaticResource PlainButton}" Content="Отмена" Click="SelectAllCancel_Click" Margin="0,0,8,0" />
                        <Button Style="{StaticResource DangerButton}" Content="Всё равно выбрать всё" Click="SelectAllConfirm_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- ===== «Are you sure?» ===== -->
        <Border x:Name="ConfirmBox" Grid.ColumnSpan="2" Background="#B3000000" Visibility="Collapsed">
            <Border Style="{StaticResource Card}" Width="470" Padding="22,20" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource LineStrongBrush}">
                <StackPanel>
                    <TextBlock Text="Удалить выбранное?" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="ConfirmSize" FontSize="14" Margin="0,10,0,0" TextWrapping="Wrap" />
                    <TextBlock x:Name="ConfirmText" Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="19" />
                    <TextBlock x:Name="ConfirmWarning" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="19" FontSize="12.5"
                               Foreground="{StaticResource WarnBrush}" Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Style="{StaticResource PlainButton}" Content="Отмена" Click="ConfirmCancel_Click" Margin="0,0,8,0" />
                        <Button Style="{StaticResource DangerButton}" Content="Да, удалить" Click="ConfirmDelete_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
