<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Reading processes and ports, and stopping processes safely.
    No WPF here: the admin helper uses this library too and should stay small.
  -->
  <PropertyGroup>
    <RootNamespace>Wipriss.ProcessTools</RootNamespace>
    <!-- Function pointers for calling the Windows network usage API without the 20 MB projection -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>
