<Window x:Class="Wipriss.Reader.TableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:view="clr-namespace:Wipriss.Reader.View"
        Title="Wipriss · Таблица"
        WindowStartupLocation="CenterScreen" Width="1240" Height="800" MinWidth="560" MinHeight="380"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar: the file on the left, search and view controls on the right -->
        <Grid x:Name="Toolbar" Margin="16,12,12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="120" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock x:Name="FileName" FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="FileInfo" Style="{StaticResource Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Width="250">
                    <TextBox x:Name="SearchBox" Style="{StaticResource InputBox}" Tag="Найти в таблице   Ctrl+F" Padding="30,6,9,6"
                             TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown" />
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="11,0,0,0"
                               Foreground="{StaticResource FaintTextBrush}" VerticalAlignment="Center" IsHitTestVisible="False" />
                </Grid>
                <TextBlock x:Name="SearchInfo" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,2,0" MinWidth="10" />
                <Button x:Name="PrevMatch" Style="{StaticResource IconButton}" Content="&#xE70E;" ToolTip="Предыдущее   Shift+F3"
                        Click="PrevMatch_Click" IsEnabled="False" />
                <Button x:Name="NextMatch" Style="{StaticResource IconButton}" Content="&#xE70D;" ToolTip="Следующее   F3"
                        Click="NextMatch_Click" IsEnabled="False" />
                <ToggleButton x:Name="OnlyMatches" Style="{StaticResource Pill}" Content="Только найденные" Margin="4,0,0,0"
                              ToolTip="Показать только строки, где есть найденный текст"
                              Checked="OnlyMatches_Changed" Unchecked="OnlyMatches_Changed" IsEnabled="False" />
                <ToggleButton x:Name="HeaderToggle" Style="{StaticResource Pill}" Content="Шапка" Margin="6,0,0,0"
                              ToolTip="Закрепить первую строку: она остаётся сверху при прокрутке"
                              Checked="HeaderToggle_Changed" Unchecked="HeaderToggle_Changed" />
                <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Content="Сохранить" Margin="6,0,0,0"
                        Visibility="Collapsed" Click="Save_Click"
                        ToolTip="Записать изменения в этот же файл   Ctrl+S">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Отменить все изменения" Click="Discard_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <Border Width="1" Height="20" Margin="10,0" Background="{StaticResource DividerBrush}" />

                <Button Style="{StaticResource IconButton}" Content="&#xE71F;" ToolTip="Мельче   Ctrl+−" Click="ZoomOut_Click" />
                <Button x:Name="ZoomText" Style="{StaticResource TextButton}" Content="100%" ToolTip="Обычный размер   Ctrl+0"
                        Click="ZoomReset_Click" />
                <Button Style="{StaticResource IconButton}" Content="&#xE8A3;" ToolTip="Крупнее   Ctrl++" Click="ZoomIn_Click" />

                <Border Width="1" Height="20" Margin="10,0" Background="{StaticResource DividerBrush}" />

                <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Перечитать файл   F5" Click="Reload_Click" />
                <Button Style="{StaticResource IconButton}" Content="&#xE8E5;" ToolTip="Открыть другую таблицу   Ctrl+O" Click="Open_Click" />
                <Button x:Name="ExportButton" Style="{StaticResource IconButton}" Content="&#xEDE1;" Click="Export_Click"
                        ToolTip="Экспорт: сохранить таблицу как XLSX или CSV под другим именем или в другую папку" />
            </StackPanel>
        </Grid>

        <!-- The whole text of the active cell: long or multi-line text is easy to read here -->
        <StackPanel Grid.Row="1" Margin="16,0,16,8">
        <Border Background="{StaticResource SunkenBrush}" BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="64" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CellAddress" Margin="12,0,10,0" VerticalAlignment="Center" FontFamily="{StaticResource SmallFont}"
                           FontSize="12" Foreground="{StaticResource AccentBrush}" />
                <Border Grid.Column="1" Width="1" Margin="0,6" Background="{StaticResource DividerBrush}" />
                <TextBox x:Name="CellText" Grid.Column="2" IsReadOnly="True"
                         PreviewKeyDown="CellText_PreviewKeyDown" GotKeyboardFocus="CellText_GotKeyboardFocus"
                         LostKeyboardFocus="CellText_LostKeyboardFocus" TextWrapping="Wrap" AcceptsReturn="True"
                         Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}"
                         CaretBrush="{StaticResource TextBrush}" SelectionBrush="#6F8F78" Padding="10,7" MaxHeight="110"
                         VerticalScrollBarVisibility="Auto" FontSize="13" />
            </Grid>
        </Border>

        <!-- Formatting of the selected cells (XLSX only; a CSV can't keep it) -->
        <Grid x:Name="FormatArea" Margin="0,6,0,0" Visibility="Collapsed">
            <StackPanel x:Name="FormatBar" Orientation="Horizontal">
                <Button x:Name="FontSmaller" Style="{StaticResource FormatButton}" Content="&#xE8E7;" ToolTip="Текст мельче" Click="FontSmaller_Click" />
                <Button x:Name="FontSizeButton" Style="{StaticResource TextButton}" Content="11" ToolTip="Размер текста" Click="FontSize_Click" />
                <Button x:Name="FontBigger" Style="{StaticResource FormatButton}" Content="&#xE8E8;" ToolTip="Текст крупнее" Click="FontBigger_Click" />
                <Border Width="1" Height="18" Margin="8,0" Background="{StaticResource DividerBrush}" />
                <ToggleButton x:Name="BoldToggle" Style="{StaticResource FormatToggle}" Content="&#xE8DD;" ToolTip="Жирный   Ctrl+B" Click="Bold_Click" />
                <ToggleButton x:Name="ItalicToggle" Style="{StaticResource FormatToggle}" Content="&#xE8DB;" ToolTip="Курсив   Ctrl+I" Click="Italic_Click" />
                <ToggleButton x:Name="UnderlineToggle" Style="{StaticResource FormatToggle}" Content="&#xE8DC;" ToolTip="Подчёркнутый   Ctrl+U" Click="Underline_Click" />
                <Border Width="1" Height="18" Margin="8,0" Background="{StaticResource DividerBrush}" />
                <Button x:Name="TextColorButton" Style="{StaticResource FormatButton}" ToolTip="Цвет текста" Click="TextColor_Click">
                    <Grid Width="16" Height="18">
                        <TextBlock Text="&#xE8D3;" HorizontalAlignment="Center" VerticalAlignment="Top" />
                        <Border x:Name="TextColorBar" Height="3" VerticalAlignment="Bottom" CornerRadius="1" Background="{StaticResource TextBrush}" />
                    </Grid>
                </Button>
                <Button x:Name="FillColorButton" Style="{StaticResource FormatButton}" ToolTip="Заливка ячейки" Click="FillColor_Click">
                    <Grid Width="16" Height="18">
                        <TextBlock Text="&#xE7E6;" HorizontalAlignment="Center" VerticalAlignment="Top" />
                        <Border x:Name="FillColorBar" Height="3" VerticalAlignment="Bottom" CornerRadius="1" Background="Transparent"
                                BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1" />
                    </Grid>
                </Button>
                <Border Width="1" Height="18" Margin="8,0" Background="{StaticResource DividerBrush}" />
                <ToggleButton x:Name="AlignLeft" Style="{StaticResource FormatToggle}" Content="&#xE8E4;" ToolTip="По левому краю" Click="Horizontal_Click" />
                <ToggleButton x:Name="AlignCenter" Style="{StaticResource FormatToggle}" Content="&#xE8E3;" ToolTip="По центру" Click="Horizontal_Click" />
                <ToggleButton x:Name="AlignRight" Style="{StaticResource FormatToggle}" Content="&#xE8E2;" ToolTip="По правому краю" Click="Horizontal_Click" />
                <Border Width="1" Height="18" Margin="8,0" Background="{StaticResource DividerBrush}" />
                <ToggleButton x:Name="AlignTop" Style="{StaticResource FormatToggle}" ToolTip="По верхнему краю" Click="Vertical_Click">
                    <Canvas Width="14" Height="14">
                        <Rectangle Canvas.Left="0" Canvas.Top="0" Width="14" Height="1.2" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                        <Rectangle Canvas.Left="4" Canvas.Top="2.5" Width="6" Height="7.5" RadiusX="1" RadiusY="1"
                                   Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.2" />
                    </Canvas>
                </ToggleButton>
                <ToggleButton x:Name="AlignMiddle" Style="{StaticResource FormatToggle}" ToolTip="По середине" Click="Vertical_Click">
                    <Canvas Width="14" Height="14">
                        <Rectangle Canvas.Left="0" Canvas.Top="6.5" Width="14" Height="1.2" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                        <Rectangle Canvas.Left="4" Canvas.Top="3" Width="6" Height="8" RadiusX="1" RadiusY="1"
                                   Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.2" />
                    </Canvas>
                </ToggleButton>
                <ToggleButton x:Name="AlignBottom" Style="{StaticResource FormatToggle}" ToolTip="По нижнему краю" Click="Vertical_Click">
                    <Canvas Width="14" Height="14">
                        <Rectangle Canvas.Left="0" Canvas.Top="13" Width="14" Height="1.2" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                        <Rectangle Canvas.Left="4" Canvas.Top="4.5" Width="6" Height="7.5" RadiusX="1" RadiusY="1"
                                   Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.2" />
                    </Canvas>
                </ToggleButton>
                <Border Width="1" Height="18" Margin="8,0" Background="{StaticResource DividerBrush}" />
                <ToggleButton x:Name="MergeToggle" Style="{StaticResource Pill}" Content="Объединить" Click="Merge_Click"
                              ToolTip="Объединить выделенные ячейки в одну или разъединить объединённые" />
                <Button x:Name="TextModeButton" Style="{StaticResource TextButton}" Margin="6,0,0,0" Click="TextMode_Click"
                        FontFamily="{StaticResource UiFont}" FontSize="12.5" ToolTip="Как показывать текст, который не помещается в ячейку">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="ModeClip" Header="Обрезать" InputGestureText="текст с «…»" Click="ModeClip_Click" />
                            <MenuItem x:Name="ModeWrap" Header="Переносить" InputGestureText="строка выше" Click="ModeWrap_Click" />
                            <MenuItem x:Name="ModeOverflow" Header="Показывать целиком" InputGestureText="на соседние" Click="ModeOverflow_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
            <!-- Over the bar when it can't be used: says why -->
            <Border x:Name="FormatBlocker" Background="Transparent" Visibility="Collapsed"
                    ToolTip="В CSV форматирование не хранится. Экспортируйте таблицу в XLSX, чтобы оформить её." />
        </Grid>
        </StackPanel>

        <Popup x:Name="ColorPopup" StaysOpen="False" AllowsTransparency="True" Placement="Bottom">
            <Border Background="#1C1B18" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1" CornerRadius="9" Padding="6">
                <StackPanel>
                    <Button x:Name="ColorAuto" Style="{StaticResource TextButton}" HorizontalAlignment="Stretch" Click="ColorAuto_Click"
                            FontFamily="{StaticResource UiFont}" FontSize="12.5" />
                    <WrapPanel x:Name="Swatches" Width="168" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </Popup>

        <!-- The table -->
        <Border Grid.Row="2" Margin="16,0,16,0" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <view:TableGrid x:Name="Table">
                    <view:TableGrid.ContextMenu>
                        <ContextMenu Opened="TableMenu_Opened">
                            <MenuItem x:Name="MenuCopy" Header="Копировать" InputGestureText="Ctrl+C" Click="Copy_Click" />
                            <MenuItem Header="Копировать строку целиком" Click="CopyRow_Click" />
                            <MenuItem x:Name="MenuPaste" Header="Вставить" InputGestureText="Ctrl+V" Click="Paste_Click" />
                            <MenuItem x:Name="MenuClear" Header="Очистить" InputGestureText="Delete" Click="Clear_Click" />
                            <MenuItem x:Name="MenuUndo" Header="Отменить" InputGestureText="Ctrl+Z" Click="Undo_Click" />
                            <Separator />
                            <MenuItem x:Name="MenuSortUp" Header="Сортировать по возрастанию" Click="SortUp_Click" />
                            <MenuItem x:Name="MenuSortDown" Header="Сортировать по убыванию" Click="SortDown_Click" />
                            <MenuItem x:Name="MenuSortOff" Header="Как в файле" Click="SortOff_Click" />
                            <Separator />
                            <MenuItem Header="Выделить всё" InputGestureText="Ctrl+A" Click="SelectAll_Click" />
                        </ContextMenu>
                    </view:TableGrid.ContextMenu>
                </view:TableGrid>
                <!-- The cell being edited: a text box right over it -->
                <Canvas x:Name="EditLayer" ClipToBounds="True">
                    <TextBox x:Name="CellEditor" Visibility="Collapsed" Background="#1E1D1A" Foreground="{StaticResource TextBrush}"
                             CaretBrush="{StaticResource TextBrush}" SelectionBrush="#6F8F78" BorderBrush="{StaticResource AccentBrush}"
                             BorderThickness="2" Padding="4,0" VerticalContentAlignment="Center" AcceptsReturn="False"
                             PreviewKeyDown="CellEditor_PreviewKeyDown" LostKeyboardFocus="CellEditor_LostKeyboardFocus"
                             TextChanged="CellEditor_TextChanged">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center"
                                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                                </Border>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>
                </Canvas>
                <ScrollBar x:Name="VScroll" Grid.Column="1" Style="{StaticResource VScroll}" Minimum="0" SmallChange="3"
                           Scroll="VScroll_Scroll" />
                <ScrollBar x:Name="HScroll" Grid.Row="1" Style="{StaticResource HScroll}" Minimum="0" SmallChange="60"
                           Scroll="HScroll_Scroll" />
                <Border Grid.Row="1" Grid.Column="1" Background="#141311" />

                <!-- Opening, sorting, errors -->
                <Border x:Name="Overlay" Grid.ColumnSpan="2" Grid.RowSpan="2" Background="#E6121110" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}" Padding="22,18" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                        <StackPanel>
                            <TextBlock x:Name="OverlayTitle" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="OverlayText" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" />
                            <StackPanel x:Name="OverlayButtons" Orientation="Horizontal" Margin="0,14,0,0" Visibility="Collapsed">
                                <Button Style="{StaticResource PrimaryButton}" Content="Открыть другой файл…" Click="Open_Click" />
                                <Button Style="{StaticResource PlainButton}" Content="Попробовать снова" Margin="8,0,0,0" Click="Reload_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>
        </Border>

        <!-- Sheets on the left; how a CSV is read and what is selected on the right -->
        <Grid Grid.Row="3" Margin="16,8,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="Tabs_PreviewMouseWheel"
                          x:Name="TabsScroll">
                <Border x:Name="TabsTrack" Style="{StaticResource SegmentTrack}" Visibility="Collapsed">
                    <StackPanel x:Name="Tabs" Orientation="Horizontal" />
                </Border>
            </ScrollViewer>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="SelectionInfo" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,12,0" />
                <Button x:Name="EncodingButton" Style="{StaticResource PlainButton}" Visibility="Collapsed" Click="EncodingButton_Click"
                        ToolTip="Кодировку Wipriss определяет сам. Меняйте её, только если вместо букв видны странные знаки" />
                <Button x:Name="DelimiterButton" Style="{StaticResource PlainButton}" Visibility="Collapsed" Margin="6,0,0,0"
                        Click="DelimiterButton_Click" ToolTip="Чем разделены столбцы в этом CSV. Wipriss определяет это сам; другой вариант нужен, только если столбцы слиплись в один" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
