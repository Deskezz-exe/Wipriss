<?xml version="1.0" encoding="utf-8"?>
<!--
  The sparse ("packaged with external location") package behind "Изменить через Wipriss" in the Windows 11
  Explorer menu. It holds only this manifest and a logo; the COM server is WiprissExplorerMenu.dll in the
  Wipriss folder (the external location given at registration). Packed by tools/make-explorer-package.cs.
  Based on the manifest of Filee (ExplorerMenuPackage.CreateManifest, MIT, Myeonggu Kim and Filee contributors);
  changes: Wipriss names and CLSIDs, a static file, picture types only instead of "*" (the tables entry keeps "*" and checks the type in the DLL).

  Unsigned: the publisher carries the special OID that Windows requires for unsigned packages, so it can never
  pose as a signed one. Registering it needs administrator rights once (Wipriss.Helper.exe "menu-add").
  Bump Version only when this file changes.
-->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
         xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
         xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
         xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap uap10 desktop4 desktop5 com rescap">
  <Identity Name="Wipriss.ExplorerMenu"
            Publisher="CN=Wipriss, OID.2.25.311729368913984317654407730594956997722=1"
            Version="1.2.0.0"
            ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>Wipriss</DisplayName>
    <PublisherDisplayName>Wipriss contributors</PublisherDisplayName>
    <Logo>Assets\Logo.png</Logo>
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>
  <Resources>
    <Resource Language="ru-ru" />
  </Resources>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
  <Applications>
    <Application Id="Wipriss" Executable="Wipriss.exe" uap10:TrustLevel="mediumIL" uap10:RuntimeBehavior="win32App">
      <!-- AppListEntry="none": the package only carries the menu, it adds nothing to the Start menu. -->
      <uap:VisualElements AppListEntry="none" DisplayName="Wipriss" Description="Wipriss in the Explorer menu"
                          BackgroundColor="transparent" Square150x150Logo="Assets\Logo.png" Square44x44Logo="Assets\Logo.png" />
      <Extensions>
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type=".jpg"><desktop5:Verb Id="WiprissEdit" Clsid="C85DED4B-4368-4428-8528-D4DF9B741C95" /></desktop5:ItemType>
            <desktop5:ItemType Type=".jpeg"><desktop5:Verb Id="WiprissEdit" Clsid="C85DED4B-4368-4428-8528-D4DF9B741C95" /></desktop5:ItemType>
            <desktop5:ItemType Type=".jfif"><desktop5:Verb Id="WiprissEdit" Clsid="C85DED4B-4368-4428-8528-D4DF9B741C95" /></desktop5:ItemType>
            <desktop5:ItemType Type=".jpe"><desktop5:Verb Id="WiprissEdit" Clsid="C85DED4B-4368-4428-8528-D4DF9B741C95" /></desktop5:ItemType>
            <desktop5:ItemType Type=".png"><desktop5:Verb Id="WiprissEdit" Clsid="C85DED4B-4368-4428-8528-D4DF9B741C95" /></desktop5:ItemType>
            <desktop5:ItemType Type=".webp"><desktop5:Verb Id="WiprissEdit" Clsid="C85DED4B-4368-4428-8528-D4DF9B741C95" /></desktop5:ItemType>
            <desktop5:ItemType Type=".avif"><desktop5:Verb Id="WiprissEdit" Clsid="C85DED4B-4368-4428-8528-D4DF9B741C95" /></desktop5:ItemType>
            <desktop5:ItemType Type=".heic"><desktop5:Verb Id="WiprissEdit" Clsid="C85DED4B-4368-4428-8528-D4DF9B741C95" /></desktop5:ItemType>
            <desktop5:ItemType Type=".heif"><desktop5:Verb Id="WiprissEdit" Clsid="C85DED4B-4368-4428-8528-D4DF9B741C95" /></desktop5:ItemType>
            <desktop5:ItemType Type=".bmp"><desktop5:Verb Id="WiprissEdit" Clsid="C85DED4B-4368-4428-8528-D4DF9B741C95" /></desktop5:ItemType>
            <desktop5:ItemType Type=".dib"><desktop5:Verb Id="WiprissEdit" Clsid="C85DED4B-4368-4428-8528-D4DF9B741C95" /></desktop5:ItemType>
            <desktop5:ItemType Type=".ico"><desktop5:Verb Id="WiprissEdit" Clsid="C85DED4B-4368-4428-8528-D4DF9B741C95" /></desktop5:ItemType>
            <desktop5:ItemType Type=".tif"><desktop5:Verb Id="WiprissEdit" Clsid="C85DED4B-4368-4428-8528-D4DF9B741C95" /></desktop5:ItemType>
            <desktop5:ItemType Type=".tiff"><desktop5:Verb Id="WiprissEdit" Clsid="C85DED4B-4368-4428-8528-D4DF9B741C95" /></desktop5:ItemType>
            <desktop5:ItemType Type=".gif"><desktop5:Verb Id="WiprissEdit" Clsid="C85DED4B-4368-4428-8528-D4DF9B741C95" /></desktop5:ItemType>
            <desktop5:ItemType Type="*"><desktop5:Verb Id="WiprissTable" Clsid="5E0B6C2A-7D41-4F3B-9A86-2C1F04B9D7E3" /></desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="Wipriss context menu">
              <com:Class Id="C85DED4B-4368-4428-8528-D4DF9B741C95" Path="WiprissExplorerMenu.dll" ThreadingModel="STA" />
              <com:Class Id="5E0B6C2A-7D41-4F3B-9A86-2C1F04B9D7E3" Path="WiprissExplorerMenu.dll" ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
