// Version information of the Explorer context-menu DLL. tools/build-explorer-menu.ps1 passes the app version as
// WIPRISS_VERSION_MAJOR/MINOR/PATCH and WIPRISS_VERSION_TEXT.
// Based on FileeExplorerMenu.rc from Filee (MIT, Myeonggu Kim and Filee contributors); names changed.

#include <winver.h>

#ifndef WIPRISS_VERSION_MAJOR
#define WIPRISS_VERSION_MAJOR 0
#define WIPRISS_VERSION_MINOR 0
#define WIPRISS_VERSION_PATCH 0
#define WIPRISS_VERSION_TEXT "0.0.0"
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION WIPRISS_VERSION_MAJOR, WIPRISS_VERSION_MINOR, WIPRISS_VERSION_PATCH, 0
PRODUCTVERSION WIPRISS_VERSION_MAJOR, WIPRISS_VERSION_MINOR, WIPRISS_VERSION_PATCH, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Wipriss contributors"
            VALUE "FileDescription", "Wipriss File Explorer context menu"
            VALUE "FileVersion", WIPRISS_VERSION_TEXT
            VALUE "InternalName", "WiprissExplorerMenu"
            VALUE "LegalCopyright", "Copyright (c) Wipriss contributors. MIT License."
            VALUE "OriginalFilename", "WiprissExplorerMenu.dll"
            VALUE "ProductName", "Wipriss"
            VALUE "ProductVersion", WIPRISS_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
