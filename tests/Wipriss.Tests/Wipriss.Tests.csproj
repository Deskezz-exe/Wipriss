<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <!-- The linked Explorer-menu switch calls Windows' package API with pointers -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Wipriss.Core\Wipriss.Core.csproj" />
    <ProjectReference Include="..\..\src\Modules\Wipriss.Modules.Agents\Wipriss.Modules.Agents.csproj" />
    <ProjectReference Include="..\..\src\Modules\Wipriss.Modules.Reminders\Wipriss.Modules.Reminders.csproj" />
    <ProjectReference Include="..\..\src\Wipriss.ProcessTools\Wipriss.ProcessTools.csproj" />
    <ProjectReference Include="..\..\src\Wipriss.Capture\Wipriss.Capture.csproj" />
    <ProjectReference Include="..\..\src\Wipriss.Converter\Wipriss.Converter.csproj" />
    <ProjectReference Include="..\..\src\Wipriss.Reader\Wipriss.Reader.csproj" />
    <ProjectReference Include="..\..\src\Wipriss.Voice\Wipriss.Voice.csproj" />
    <ProjectReference Include="..\..\src\Wipriss.Cleaner\Wipriss.Cleaner.csproj" />
  </ItemGroup>

  <!-- Plain parts of the converter window, the Explorer menu and the app, compiled in for testing
       (the module itself can't be referenced: it carries its own copy of the converter protocol). -->
  <ItemGroup>
    <Compile Include="..\..\src\Modules\Wipriss.Modules.Converter\ConverterSession.cs" Link="Linked\ConverterSession.cs" />
    <Compile Include="..\..\src\Modules\Wipriss.Modules.Converter\OriginalReplacer.cs" Link="Linked\OriginalReplacer.cs" />
    <Compile Include="..\..\src\Modules\Wipriss.Modules.Converter\ShellNotify.cs" Link="Linked\ShellNotify.cs" />
    <Compile Include="..\..\src\Modules\Wipriss.Modules.Converter\PreviewGrid.cs" Link="Linked\PreviewGrid.cs" />
    <Compile Include="..\..\src\Wipriss.ExplorerMenu\MenuPackage.cs" Link="Linked\MenuPackage.cs" />
    <Compile Include="..\..\src\Wipriss.ExplorerMenu\MenuSwitch.cs" Link="Linked\MenuSwitch.cs" />
    <Compile Include="..\..\src\Wipriss.ExplorerMenu\ExplorerRestart.cs" Link="Linked\ExplorerRestart.cs" />
    <Compile Include="..\..\src\Wipriss.App\Shell\ExplorerList.cs" Link="Linked\ExplorerList.cs" />
    <Compile Include="..\..\src\Modules\Wipriss.Modules.Voice\HotkeyHook.cs" Link="Linked\HotkeyHook.cs" />
    <Compile Include="..\..\src\Modules\Wipriss.Modules.Voice\VoiceSettings.cs" Link="Linked\VoiceSettings.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
